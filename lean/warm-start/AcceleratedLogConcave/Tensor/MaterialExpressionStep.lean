import AcceleratedLogConcave.Tensor.MaterialAdjointCorrection

noncomputable section
set_option backward.isDefEq.respectTransparency false
open scoped NNReal BigOperators
namespace AcceleratedLogConcave.Tensor.ActualCoefficientIntegrability
open Conditional Analysis AdjointReduction

/-- A scalar monomial times a literal tensor expression. This records only
the scalar factors generated by the actual material differentiation rules. -/
structure MaterialTerm (r : ℕ) where
  coefficient : ℝ
  degree : ℕ
  expression : Expr signature r

def MaterialTerm.mapExpr {r s : ℕ} (f : Expr signature r → Expr signature s)
    (u : MaterialTerm r) : MaterialTerm s :=
  ⟨u.coefficient,u.degree,f u.expression⟩

def MaterialTerm.value {D r : ℕ}
    (d : PositiveVarianceFlowData (EuclideanSpace ℝ (Fin D)))
    (u : MaterialTerm r) (a : Fin r → Fin D) (p : ℝ × EuclideanSpace ℝ (Fin D)) : ℝ :=
  u.coefficient * p.1 ^ u.degree * materialExpressionValue d u.expression a p

/-- Literal one-step expression differentiation. The scale parameter is
ell*r², not an assumed analytic budget. Excluded grammar branches are empty
and will never be used under IsMaterialExpression. -/
def materialExpressionStep (l : ℝ) : {r : ℕ} → Expr signature r → List (MaterialTerm r)
  | _, .coefficient (Sum.inl n) =>
    ⟨(n+2:ℝ),0,materialJetPrincipalExpr n⟩ ::
      (scoreRoutes (List.finRange (n+1))).attach.map (fun p =>
        ⟨2*l*(materialRouteFactorialWeight p.val / ((n+1).factorial:ℝ)),1,
          materialJetRouteExpr p.val p.property⟩)
  | _, .coefficient (Sum.inr _) => []
  | _, .permute π e => (materialExpressionStep l e).map (MaterialTerm.mapExpr (.permute π))
  | _, .contract e f i j =>
      (materialExpressionStep l e).map (MaterialTerm.mapExpr (fun e' => .contract e' f i j)) ++
      (materialExpressionStep l f).map (MaterialTerm.mapExpr (fun f' => .contract e f' i j))
  | _, .derivative _ => []
  | _, .adjoint i e =>
      (materialExpressionStep l e).map (MaterialTerm.mapExpr (.adjoint i)) ++
      [⟨l,1,materialAdjointCorrection e i⟩]

private theorem isMaterial_cast {r s : ℕ} (h : r=s) (e : Expr signature r) :
    IsMaterialExpression (h ▸ e) = IsMaterialExpression e := by cases h; rfl

theorem isMaterial_materialJetRouteExpr {q : ℕ} (p : List (Fin q) × List (Fin q))
    (hp : p ∈ scoreRoutes (List.finRange q)) :
    IsMaterialExpression (materialJetRouteExpr p hp) := by
  dsimp only [materialJetRouteExpr,IsMaterialExpression]
  rw [isMaterial_cast]
  trivial

theorem materialExpressionStep_isMaterial (l : ℝ) {r : ℕ} (e : Expr signature r)
    (he : IsMaterialExpression e) :
    ∀ u ∈ materialExpressionStep l e, IsMaterialExpression u.expression := by
  induction e with
  | coefficient c =>
    cases c with
    | inl n =>
      intro u hu
      simp only [materialExpressionStep,List.mem_cons,List.mem_map] at hu
      rcases hu with rfl | ⟨p,hp,rfl⟩
      · trivial
      · exact isMaterial_materialJetRouteExpr p.val p.property
    | inr x => exact False.elim he
  | permute π e ih =>
    intro u hu
    obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
    exact ih he v hv
  | contract e f i j ihe ihf =>
    intro u hu
    rcases List.mem_append.mp hu with hu | hu
    · obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
      exact ⟨ihe he.1 v hv,he.2⟩
    · obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
      exact ⟨he.1,ihf he.2 v hv⟩
  | derivative e ih => exact False.elim he
  | adjoint i e ih =>
    intro u hu
    rcases List.mem_append.mp hu with hu | hu
    · obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
      exact ih he v hv
    · have hu' := List.mem_singleton.mp hu
      subst u
      exact ⟨he,trivial⟩

theorem materialExpressionStep_size (l : ℝ) {r : ℕ} (e : Expr signature r) :
    ∀ u ∈ materialExpressionStep l e, u.expression.size ≤ e.size+3 := by
  induction e with
  | coefficient c =>
    cases c with
    | inl n =>
      intro u hu
      simp only [materialExpressionStep,List.mem_cons,List.mem_map] at hu
      rcases hu with rfl | ⟨p,hp,rfl⟩
      · simp [materialJetPrincipalExpr_size,Expr.size,signature]
      · simpa [Expr.size,signature] using
          (le_of_eq (materialJetRouteExpr_size p.val p.property))
    | inr x => simp [materialExpressionStep]
  | permute π e ih =>
    intro u hu
    obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
    exact ih v hv
  | contract e f i j ihe ihf =>
    intro u hu
    rcases List.mem_append.mp hu with hu | hu
    · obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
      have hh := ihe v hv
      change v.expression.size+f.size+1 ≤ e.size+f.size+1+3
      omega
    · obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
      have hh := ihf v hv
      change e.size+v.expression.size+1 ≤ e.size+f.size+1+3
      omega
  | derivative e ih => simp [materialExpressionStep]
  | adjoint i e ih =>
    intro u hu
    rcases List.mem_append.mp hu with hu | hu
    · obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
      have hh := ih v hv
      change v.expression.size+1 ≤ e.size+1+3
      omega
    · have hu' := List.mem_singleton.mp hu
      subst u
      exact le_of_eq (materialAdjointCorrection_size e i)

theorem materialExpressionStep_degree (l : ℝ) {r : ℕ} (e : Expr signature r) :
    ∀ u ∈ materialExpressionStep l e, u.degree ≤ 1 := by
  induction e with
  | coefficient c =>
    cases c with
    | inl n =>
      intro u hu
      simp only [materialExpressionStep,List.mem_cons,List.mem_map] at hu
      rcases hu with rfl | ⟨p,hp,rfl⟩ <;> norm_num
    | inr x => simp [materialExpressionStep]
  | permute π e ih =>
    intro u hu
    obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
    exact ih v hv
  | contract e f i j ihe ihf =>
    intro u hu
    rcases List.mem_append.mp hu with hu | hu
    · obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
      exact ihe v hv
    · obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
      exact ihf v hv
  | derivative e ih => simp [materialExpressionStep]
  | adjoint i e ih =>
    intro u hu
    rcases List.mem_append.mp hu with hu | hu
    · obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
      exact ih v hv
    · have hu' := List.mem_singleton.mp hu
      subst u
      norm_num

theorem materialExpressionStep_weight (l : ℝ) {r : ℕ} (e : Expr signature r) :
    ∀ u ∈ materialExpressionStep l e, u.expression.weight ≤ e.weight+2 := by
  induction e with
  | coefficient c =>
    cases c with
    | inl n =>
      intro u hu
      simp only [materialExpressionStep,List.mem_cons,List.mem_map] at hu
      rcases hu with rfl | ⟨p,hp,rfl⟩
      · simp [materialJetPrincipalExpr_weight,Expr.weight,signature]
      · simp [materialJetRouteExpr_weight,Expr.weight,signature]
    | inr x => simp [materialExpressionStep]
  | permute π e ih =>
    intro u hu
    obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
    exact ih v hv
  | contract e f i j ihe ihf =>
    intro u hu
    rcases List.mem_append.mp hu with hu | hu
    · obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
      have hh := add_le_add_right (ihe v hv) f.weight
      simpa [MaterialTerm.mapExpr,Expr.weight,add_assoc,add_comm,add_left_comm] using hh
    · obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
      change e.weight+v.expression.weight ≤ e.weight+f.weight+2
      calc
        _ ≤ e.weight+(f.weight+2) := add_le_add (le_refl e.weight) (ihf v hv)
        _ = _ := by ac_rfl
  | derivative e ih => simp [materialExpressionStep]
  | adjoint i e ih =>
    intro u hu
    rcases List.mem_append.mp hu with hu | hu
    · obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hu
      have hh := add_le_add_right (ih v hv) 1
      simpa [MaterialTerm.mapExpr,Expr.weight,add_assoc,add_comm,add_left_comm] using hh
    · have hu' := List.mem_singleton.mp hu
      subst u
      simpa only [materialAdjointCorrection_weight] using
        (le_add_of_nonneg_right (show (0:ℝ≥0)≤2 by positivity) :
          (Expr.adjoint i e).weight ≤ (Expr.adjoint i e).weight+2)

end AcceleratedLogConcave.Tensor.ActualCoefficientIntegrability
