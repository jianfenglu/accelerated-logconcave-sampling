import AcceleratedLogConcave.Tensor.MaterialExpressionProduct
import AcceleratedLogConcave.Conditional.Flow.MaterialAdjointCommutator

noncomputable section
set_option backward.isDefEq.respectTransparency false
open scoped ContDiff RealInnerProductSpace BigOperators
namespace AcceleratedLogConcave.Tensor.ActualCoefficientIntegrability
open Conditional Analysis Analysis.CoupledVelocityPolynomial CoordinateReduction

/-- The subgrammar generated by actual Jq and the operations used by material
expansion. It excludes Hessian leaves and standalone spatial derivative nodes. -/
def IsMaterialExpression : {r : ℕ} → Expr signature r → Prop
  | _, .coefficient (Sum.inl _) => True
  | _, .coefficient (Sum.inr _) => False
  | _, .permute _ e => IsMaterialExpression e
  | _, .contract e f _ _ => IsMaterialExpression e ∧ IsMaterialExpression f
  | _, .derivative _ => False
  | _, .adjoint _ e => IsMaterialExpression e

private theorem contDiffOn_spatial_slice_derivative {D : ℕ}
    {f : ℝ × EuclideanSpace ℝ (Fin D) → ℝ}
    (hf : ContDiffOn ℝ ∞ f (openDomain (EuclideanSpace ℝ (Fin D))))
    (v : EuclideanSpace ℝ (Fin D)) :
    ContDiffOn ℝ ∞ (fun p : ℝ × EuclideanSpace ℝ (Fin D) =>
      fderiv ℝ (fun y => f (p.1,y)) p.2 v) (openDomain (EuclideanSpace ℝ (Fin D))) := by
  have hh := (hf.fderiv_of_isOpen (isOpen_openDomain _) (m := ∞) (by simp)).clm_apply
    (contDiffOn_const (c := (0,v)))
  apply hh.congr
  intro p hp
  have hd := (hf.contDiffAt ((isOpen_openDomain _).mem_nhds hp)).differentiableAt (by simp)
  have hc := hd.hasFDerivAt.comp p.2
    ((hasFDerivAt_const (𝕜 := ℝ) p.1 p.2).prodMk (hasFDerivAt_id (𝕜 := ℝ) p.2))
  change HasFDerivAt (fun y => f (p.1,y)) _ p.2 at hc
  rw [hc.fderiv]
  rfl

private theorem contDiffOn_actual_score_coordinate {D : ℕ}
    (d : PositiveVarianceFlowData (EuclideanSpace ℝ (Fin D)))
    (v : EuclideanSpace ℝ (Fin D)) :
    ContDiffOn ℝ ∞ (fun p : ℝ × EuclideanSpace ℝ (Fin D) =>
      fderiv ℝ (interpolationPotential d.F d.x d.r p.1) p.2 v)
      (openDomain (EuclideanSpace ℝ (Fin D))) := by
  apply ((innerSL ℝ v).contDiff.comp_contDiffOn d.contDiffOn_scoreField).congr
  intro p hp
  change fderiv ℝ (interpolationPotential d.F d.x d.r p.1) p.2 v =
    inner ℝ v (p.2 + (d.r*p.1) • conditionalMean d.F d.x d.r p.1 p.2)
  rw [← gradient_interpolationPotential d.hF d.hlo d.hhi d.x d.r hp.1 hp.2 p.2]
  simp

/-- All space-time smoothness needed by material product/adjoint rules is
inherited from original data, not supplied as a final hypothesis. -/
theorem contDiffOn_materialExpressionValue {D r : ℕ}
    (d : PositiveVarianceFlowData (EuclideanSpace ℝ (Fin D)))
    (e : Expr signature r) (he : IsMaterialExpression e) :
    ∀ a, ContDiffOn ℝ ∞ (materialExpressionValue d e a)
      (openDomain (EuclideanSpace ℝ (Fin D))) := by
  induction e with
  | coefficient c =>
    cases c with
    | inl n => exact contDiffOn_material_jet_coefficient d n
    | inr u => exact False.elim he
  | permute π e ih =>
    intro a
    exact ih he (a ∘ π)
  | contract e f i j ihe ihf =>
    intro a
    change ContDiffOn ℝ ∞ (fun p => ∑ k : Fin D,
      materialExpressionValue d e (leftAssignment i a k) p *
      materialExpressionValue d f (rightAssignment j a k) p) _
    exact ContDiffOn.sum (fun k _ => (ihe he.1 _).mul (ihf he.2 _))
  | derivative e ih => exact False.elim he
  | adjoint i e ih =>
    intro a
    change ContDiffOn ℝ ∞ (fun p => ∑ k : Fin D,
      (-fderiv ℝ (fun y => materialExpressionValue d e (Fin.insertNth i k a) (p.1,y))
          p.2 (coordinateDirection D k) +
       fderiv ℝ (interpolationPotential d.F d.x d.r p.1) p.2 (coordinateDirection D k) *
         materialExpressionValue d e (Fin.insertNth i k a) p)) _
    exact ContDiffOn.sum (fun k _ =>
      (contDiffOn_spatial_slice_derivative (ih he _) _).neg.add
        ((contDiffOn_actual_score_coordinate d _).mul (ih he _)))

theorem differentiableAt_materialExpressionValue {D r : ℕ}
    (d : PositiveVarianceFlowData (EuclideanSpace ℝ (Fin D)))
    (e : Expr signature r) (he : IsMaterialExpression e) (a : Fin r → Fin D)
    {t : ℝ} (ht : -1<t ∧ t<1) (y : EuclideanSpace ℝ (Fin D)) :
    DifferentiableAt ℝ (materialExpressionValue d e a) (t,y) :=
  ((contDiffOn_materialExpressionValue d e he a).contDiffAt
    ((isOpen_openDomain _).mem_nhds ht)).differentiableAt (by simp)

end AcceleratedLogConcave.Tensor.ActualCoefficientIntegrability
