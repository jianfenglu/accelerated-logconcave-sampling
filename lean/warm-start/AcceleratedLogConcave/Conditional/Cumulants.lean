open scoped Topology

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
variable {ι N : Type*} [DecidableEq ι] [Fintype N] [DecidableEq N]

def assignments (n₀ : N) : List ι → List (ι → N)
  | [] => [fun _ => n₀]
  | i::l => (assignments n₀ l).flatMap (fun p =>
      (Finset.univ.toList : List N).map (fun j => Function.update p i j))

omit [DecidableEq N] in
lemma length_assignments (n₀ : N) (l : List ι) :
    (assignments n₀ l).length = (Fintype.card N)^l.length := by
  induction l with
  | nil => simp [assignments]
  | cons i l ih =>
    simp only [assignments,List.length_flatMap,List.length_map,Finset.length_toList,
      Finset.card_univ,List.map_const',List.sum_replicate,smul_eq_mul,ih,List.length_cons,pow_succ]

omit [DecidableEq N] in
lemma assignments_default (n₀ : N) (l : List ι) {p : ι → N}
    (hp : p ∈ assignments n₀ l) {i : ι} (hi : i ∉ l) : p i=n₀ := by
  induction l generalizing p i with
  | nil => simpa [assignments] using congrFun (List.mem_singleton.mp hp) i
  | cons a l ih =>
    obtain ⟨q,hq,hp⟩ := List.mem_flatMap.mp hp
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hp
    have hia : i ≠ a := fun h => hi (by simp [h])
    rw [Function.update_of_ne hia]
    exact ih hq (fun h => hi (List.mem_cons_of_mem _ h))

omit [DecidableEq N] in
lemma mem_assignments (n₀ : N) (l : List ι) (hl : l.Nodup) (p : ι → N)
    (hp : ∀ i, i ∉ l → p i=n₀) : p ∈ assignments n₀ l := by
  induction l generalizing p with
  | nil =>
    have : p=(fun _ => n₀) := funext (fun i => hp i (by simp))
    simp [assignments,this]
  | cons i l ih =>
    have hin := (List.nodup_cons.mp hl).1
    have hl' := (List.nodup_cons.mp hl).2
    apply List.mem_flatMap.mpr
    refine ⟨Function.update p i n₀,ih hl' (Function.update p i n₀) (fun j hj => ?_),?_⟩
    · by_cases hji : j=i
      · simp [hji]
      · simpa [Function.update_of_ne hji] using hp j (by simp [hji,hj])
    · apply List.mem_map.mpr
      refine ⟨p i,by simp,?_⟩
      ext j
      by_cases hji : j=i <;> simp [hji,Function.update_of_ne]

omit [Fintype N] in
lemma filter_update (l : List ι) (i : ι) (hi : i ∉ l) (p : ι → N) (j n : N) :
    l.filter (fun a => Function.update p i j a=n) = l.filter (fun a => p a=n) := by
  apply List.filter_congr
  intro a ha
  have hai : a ≠ i := fun h => hi (h ▸ ha)
  simp [Function.update_of_ne hai]

lemma differentiable_list_sum {K : Type*} (l : List K) {f : K → E → ℝ}
    (hf : ∀ i ∈ l, Differentiable ℝ (f i)) :
    Differentiable ℝ (fun x => (l.map (fun i => f i x)).sum) := by
  induction l with
  | nil => simpa only [List.map_nil,List.sum_nil] using (differentiable_const (0:ℝ) : Differentiable ℝ (fun _ : E => (0:ℝ)))
  | cons i l ih =>
    simpa only [List.map_cons,List.sum_cons] using
      (hf i (by simp)).fun_add (ih (fun j hj => hf j (by simp [hj])))

lemma dir_list_sum {K : Type*} (l : List K) {f : K → E → ℝ}
    (hf : ∀ i ∈ l, Differentiable ℝ (f i)) (v : E) :
    dir v (fun x => (l.map (fun i => f i x)).sum) =
      fun x => (l.map (fun i => dir v (f i) x)).sum := by
  induction l with
  | nil =>
    funext x
    change fderiv ℝ (fun _ : E => (0:ℝ)) x v = 0
    simp
  | cons i l ih =>
    simp only [List.map_cons,List.sum_cons]
    rw [dir_add (hf i (by simp))]
    · rw [ih (fun j hj => hf j (by simp [hj]))]
    · exact differentiable_list_sum l (fun j hj => hf j (by simp [hj]))

lemma smooth_list_sum {K : Type*} (l : List K) {f : K → E → ℝ}
    (hf : ∀ i ∈ l, ContDiff ℝ (⊤ : ℕ∞) (f i)) :
    ContDiff ℝ (⊤ : ℕ∞) (fun x => (l.map (fun i => f i x)).sum) := by
  induction l with
  | nil => simpa using (contDiff_const : ContDiff ℝ (⊤ : ℕ∞) (fun _ : E => (0:ℝ)))
  | cons i l ih =>
    simpa only [List.map_cons,List.sum_cons] using
      (hf i (by simp)).add (ih (fun j hj => hf j (by simp [hj])))

omit [DecidableEq ι] in
lemma jet_list_sum {K : Type*} (t : List K) {f : K → E → ℝ}
    (hf : ∀ i ∈ t, ContDiff ℝ (⊤ : ℕ∞) (f i)) (v : ι → E) (l : List ι) :
    jet v l (fun x => (t.map (fun i => f i x)).sum) =
      fun x => (t.map (fun i => jet v l (f i) x)).sum := by
  induction l with
  | nil => rfl
  | cons i l ih =>
    simp only [jet,ih]
    exact dir_list_sum t (fun j hj => (smooth_jet (hf j hj) v l).differentiable (by simp)) _

lemma list_sum_flatMap {K : Type*} (l : List K) (f : K → List ℝ) :
    (l.flatMap f).sum=(l.map (fun i => (f i).sum)).sum := by
  induction l with
  | nil => rfl
  | cons i l ih => simp [ih]

omit [DecidableEq N] in
lemma sum_eq_list (f : N → ℝ) :
    (∑ n, f n) = ((Finset.univ.toList : List N).map f).sum := by
  classical
  simp only [← List.sum_toFinset f (Finset.nodup_toList (Finset.univ : Finset N)),
    Finset.toList_toFinset]

lemma dir_prod {f : N → E → ℝ} (hf : ∀ n, Differentiable ℝ (f n)) (v : E) :
    dir v (fun x => ∏ n, f n x) = fun x =>
      ∑ j, ∏ n, (if n=j then dir v (f n) x else f n x) := by
  funext x
  rw [dir,(HasFDerivAt.finsetProd (fun n (_ : n ∈ (Finset.univ : Finset N)) =>
    (hf n x).hasFDerivAt)).fderiv]
  simp only [_root_.sum_apply,smul_apply,smul_eq_mul]
  apply Finset.sum_congr rfl
  intro j hj
  have hh : (fun n => if n=j then dir v (f n) x else f n x)=
      Function.update (fun n => f n x) j (dir v (f j) x) := by ext n; by_cases h : n=j <;> simp [h]
  rw [hh,Finset.prod_update_of_mem hj]
  simp only [Finset.sdiff_singleton_eq_erase,dir]
  ring

theorem jet_prod {f : N → E → ℝ} (hf : ∀ n, ContDiff ℝ (⊤ : ℕ∞) (f n))
    (n₀ : N) (v : ι → E) (l : List ι) (hl : l.Nodup) :
    jet v l (fun x => ∏ n, f n x) = fun x =>
      ((assignments n₀ l).map (fun p => ∏ n, jet v (l.filter (fun i => p i=n)) (f n) x)).sum := by
  induction l with
  | nil => simp [jet,assignments]
  | cons i l ih =>
    have hi := (List.nodup_cons.mp hl).1
    have hl' := (List.nodup_cons.mp hl).2
    rw [jet,ih hl',dir_list_sum _ (fun p hp =>
      (contDiff_prod (fun n _ => smooth_jet (hf n) v _)).differentiable (by simp))]
    funext x
    simp only [assignments,List.map_flatMap,list_sum_flatMap,List.map_map,Function.comp_def]
    apply congrArg List.sum
    apply List.map_congr_left
    intro p hp
    rw [dir_prod (fun n => (smooth_jet (hf n) v _).differentiable (by simp))]
    dsimp only
    rw [sum_eq_list]
    apply congrArg List.sum
    apply List.map_congr_left
    intro j hj
    apply Finset.prod_congr rfl
    intro n hn
    rw [List.filter_cons,filter_update l i hi]
    by_cases hnj : n=j
    · simp [hnj,jet]
    · simp [hnj,Ne.symm hnj]

end JetCalculus
end AcceleratedLogConcave.Conditional
namespace AcceleratedLogConcave.Conditional
namespace JetCalculus
open scoped Topology

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
variable {ι κ N : Type*} [Fintype ι] [DecidableEq ι]
  [Fintype κ] [DecidableEq κ] [Fintype N] [DecidableEq N]

lemma assignments_toFinset (n₀ : N) (l : List ι) (hl : l.Nodup)
    (hall : l.toFinset=Finset.univ) : (assignments n₀ l).toFinset=Finset.univ := by
  classical
  apply Finset.eq_univ_iff_forall.mpr
  intro p
  apply List.mem_toFinset.mpr (mem_assignments n₀ l hl p ?_)
  intro i hi
  exfalso
  exact hi (List.mem_toFinset.mp (by rw [hall]; exact Finset.mem_univ i))

lemma assignments_nodup (n₀ : N) (l : List ι) (hl : l.Nodup)
    (hall : l.toFinset=Finset.univ) : (assignments n₀ l).Nodup := by
  classical
  change (↑(assignments n₀ l) : Multiset (ι → N)).Nodup
  apply Multiset.toFinset_card_eq_card_iff_nodup.mp
  change (assignments n₀ l).toFinset.card=(assignments n₀ l).length
  rw [assignments_toFinset n₀ l hl hall,Finset.card_univ,Fintype.card_fun,length_assignments]
  congr 1
  simpa only [hall,Finset.card_univ] using (List.toFinset_card_of_nodup hl)

lemma assignments_sum (n₀ : N) (l : List ι) (hl : l.Nodup)
    (hall : l.toFinset=Finset.univ) (f : (ι → N) → ℝ) :
    ((assignments n₀ l).map f).sum=∑ p, f p := by
  classical
  rw [← List.sum_toFinset _ (assignments_nodup n₀ l hl hall),
    assignments_toFinset n₀ l hl hall]

theorem jet_prod_sum {f : N → E → ℝ} (hf : ∀ n, ContDiff ℝ (⊤ : ℕ∞) (f n))
    (n₀ : N) (v : ι → E) (l : List ι) (hl : l.Nodup) (hall : l.toFinset=Finset.univ) :
    jet v l (fun x => ∏ n, f n x) = fun x =>
      ∑ p : ι → N, ∏ n, jet v (l.filter (fun i => p i=n)) (f n) x := by
  rw [jet_prod hf n₀ v l hl]
  funext x
  exact assignments_sum n₀ l hl hall _

omit [Fintype κ] [DecidableEq κ] in
lemma smooth_right_jet {f : E × F → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (w : κ → F) (k : List κ) (ω : F) :
    ContDiff ℝ (⊤ : ℕ∞) (fun θ => jet w k (fun ω => f (θ,ω)) ω) := by
  simp_rw [jet_right_slice hf]
  exact (smooth_jet hf _ k).comp (contDiff_id.prodMk contDiff_const)

theorem mixedJet_prod_sum {f : N → E × F → ℝ}
    (hf : ∀ n, ContDiff ℝ (⊤ : ℕ∞) (f n)) (n₀ : N)
    (v : ι → E) (w : κ → F) (l : List ι) (k : List κ)
    (hl : l.Nodup) (hlall : l.toFinset=Finset.univ)
    (hk : k.Nodup) (hkall : k.toFinset=Finset.univ) :
    mixedJet v w l k (fun x => ∏ n, f n x) =
      ∑ p : ι → N, ∑ q : κ → N,
        ∏ n, mixedJet v w (l.filter (fun i => p i=n)) (k.filter (fun j => q j=n)) (f n) := by
  unfold mixedJet
  have hr (θ : E) : jet w k (fun ω => ∏ n, f n (θ,ω)) = fun ω =>
      ∑ q : κ → N, ∏ n, jet w (k.filter (fun j => q j=n)) (fun ω => f n (θ,ω)) ω :=
    jet_prod_sum (fun n => (hf n).comp (contDiff_const.prodMk contDiff_id)) n₀ w k hk hkall
  simp_rw [hr]
  rw [jet_sum _ (fun q hq => contDiff_prod (fun n _ => smooth_right_jet (hf n) w _ 0))]
  have hleft (q : κ → N) : jet v l (fun θ => ∏ n,
      jet w (k.filter (fun j => q j=n)) (fun ω => f n (θ,ω)) 0) = fun θ =>
      ∑ p : ι → N, ∏ n, jet v (l.filter (fun i => p i=n))
        (fun θ => jet w (k.filter (fun j => q j=n)) (fun ω => f n (θ,ω)) 0) θ :=
    jet_prod_sum (fun n => smooth_right_jet (hf n) w _ 0) n₀ v l hl hlall
  simp_rw [hleft]
  exact Finset.sum_comm

end JetCalculus
end AcceleratedLogConcave.Conditional
namespace AcceleratedLogConcave.Conditional
namespace JetCalculus
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] {ι κ : Type*}

lemma mixedJet_fst (f : E → ℝ) (v : ι → E) (w : κ → F) (l : List ι) (k : List κ)
    (hk : k≠[]) : mixedJet v w l k (fun x => f x.1)=0 := by
  simp only [mixedJet,jet_const,hk,↓reduceIte]
  split_ifs <;> rfl

lemma mixedJet_snd (f : F → ℝ) (v : ι → E) (w : κ → F) (l : List ι) (k : List κ)
    (hl : l≠[]) : mixedJet v w l k (fun x => f x.2)=0 := by
  simp only [mixedJet,jet_const,hl,↓reduceIte]

end JetCalculus
end AcceleratedLogConcave.Conditional

end


/-!
Local Laplace regularity from an actual multivariate MGF neighborhood.
The calculus proof is adapted from openai/math revision
1581d4cbdd69a0faf34b2089614fe2a814316a6a, JetEstimates/Bound.lean
(Apache-2.0), replacing its global exponential-moment hypothesis by a
single strictly positive exponential norm moment.
-/
namespace AcceleratedLogConcave.Conditional
noncomputable section
open MeasureTheory Filter
open scoped Topology RealInnerProductSpace

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]

/-- Finitely many signed-coordinate MGF values dominate an exponential norm moment. -/
lemma HasLocalMGF.exists_integrable_exp_norm_basis {μ : Measure E}
    (hμ : HasLocalMGF μ) {κ : Type*} [Fintype κ]
    (b : OrthonormalBasis κ ℝ E) :
    ∃ r : ℝ, 0 < r ∧ Integrable (fun x : E => Real.exp (r * ‖x‖)) μ := by
  classical
  obtain ⟨δ, hδ, hball⟩ := Metric.eventually_nhds_iff.mp hμ
  let r : ℝ := δ / (Fintype.card κ + 1)
  have hr : 0 < r := div_pos hδ (by positivity)
  let v : (κ → Bool) → E := fun s => ∑ i, (if s i then r else -r) • b i
  have hv (s : κ → Bool) : ‖v s‖ ≤ (Fintype.card κ : ℝ) * r := by
    calc
      ‖v s‖ ≤ ∑ i, ‖(if s i then r else -r) • b i‖ := norm_sum_le _ _
      _ = (Fintype.card κ : ℝ) * r := by
        simp only [norm_smul, b.norm_eq_one, mul_one]
        have he (i : κ) : ‖(if s i then r else -r : ℝ)‖ = r := by
          split <;> simp [abs_of_pos hr, Real.norm_eq_abs]
        simp_rw [he]
        simp
  have hvr (s : κ → Bool) : ‖v s‖ < δ := by
    apply (hv s).trans_lt
    dsimp [r]
    have hn : (0 : ℝ) < Fintype.card κ + 1 := by positivity
    rw [← mul_div_assoc, div_lt_iff₀ hn]
    nlinarith
  have hi (s : κ → Bool) : Integrable (fun x => Real.exp (inner ℝ (v s) x)) μ :=
    hball (by simpa using hvr s)
  refine ⟨r, hr, (integrable_finsetSum Finset.univ (fun s _ => hi s)).mono'
    (by fun_prop) (Filter.Eventually.of_forall fun x => ?_)⟩
  simp only [Real.norm_eq_abs, Real.abs_exp]
  let s : κ → Bool := fun i => decide (0 ≤ inner ℝ (b i) x)
  have hsign (i : κ) : (if s i then r else -r) * inner ℝ (b i) x =
      r * |inner ℝ (b i) x| := by
    dsimp [s]
    simp only [decide_eq_true_eq]
    split_ifs with hh
    · rw [abs_of_nonneg hh]
    · rw [abs_of_neg (lt_of_not_ge hh)]; ring
  have hnorm : ‖x‖ ≤ ∑ i, |inner ℝ (b i) x| := by
    calc
      ‖x‖ = ‖∑ i, inner ℝ (b i) x • b i‖ := congrArg norm (b.sum_repr' x).symm
      _ ≤ ∑ i, ‖inner ℝ (b i) x • b i‖ := norm_sum_le _ _
      _ = _ := by simp [norm_smul, Real.norm_eq_abs]
  have hinner : r * ‖x‖ ≤ inner ℝ (v s) x := by
    dsimp [v]
    rw [sum_inner]
    simp_rw [real_inner_smul_left, hsign]
    rw [← Finset.mul_sum]
    exact mul_le_mul_of_nonneg_left hnorm hr.le
  exact (Real.exp_le_exp.mpr hinner).trans
    (Finset.single_le_sum (fun t _ => (Real.exp_pos (inner ℝ (v t) x)).le)
      (Finset.mem_univ s))

/-- Finite-dimensional local MGF finiteness supplies a positive exponential norm moment. -/
lemma HasLocalMGF.exists_integrable_exp_norm [FiniteDimensional ℝ E] {μ : Measure E}
    (hμ : HasLocalMGF μ) :
    ∃ r : ℝ, 0 < r ∧ Integrable (fun x : E => Real.exp (r * ‖x‖)) μ :=
  hμ.exists_integrable_exp_norm_basis (stdOrthonormalBasis ℝ E)

namespace Appell

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- The Bochner-valued polynomially weighted Laplace transform. -/
def laplace (μ : Measure E) (h : E → F) (θ : E) : F :=
  ∫ x, Real.exp (inner ℝ θ x) • h x ∂μ

/-- Insertion of one direction into the Laplace integrand. -/
def inserted (h : E → F) (x : E) : E →L[ℝ] F :=
  (innerSL ℝ x).smulRight (h x)

omit [MeasurableSpace E] [BorelSpace E] in
lemma continuous_inserted {h : E → F} (hh : Continuous h) : Continuous (inserted h) :=
  isBoundedBilinearMap_smulRight.continuous.comp ((innerSL ℝ).continuous.prodMk hh)

omit [MeasurableSpace E] [BorelSpace E] in
lemma growth_inserted {h : E → F} (hg : HasGrowth h) : HasGrowth (inserted h) := by
  obtain ⟨C,hC,n,hn⟩ := hg
  refine ⟨2*C,by positivity,n+1,fun x => ?_⟩
  have hb : ‖inserted h x‖ ≤ ‖x‖*‖h x‖ := by
    simp [inserted,ContinuousLinearMap.norm_smulRight_apply]
  have hp := pow_le_one_add_pow_add (norm_nonneg x) 1 n
  rw [pow_one,Nat.add_comm 1 n] at hp
  have hh := mul_le_mul_of_nonneg_left (hn x) (norm_nonneg x)
  have hh' := hb.trans hh
  have hp' : ‖x‖*‖x‖^n=‖x‖^(n+1) := (pow_succ' _ _).symm
  nlinarith [mul_le_mul_of_nonneg_left hp hC,
    mul_nonneg hC (pow_nonneg (norm_nonneg x) (n+1)),
    congrArg (fun z : ℝ => C*z) hp']

omit [MeasurableSpace E] [BorelSpace E] [InnerProductSpace ℝ E] [NormedSpace ℝ F] in
/-- Polynomial growth can be absorbed using any strictly positive exponential rate. -/
lemma growth_exp_bound_rate {h : E → F} (hg : HasGrowth h) {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x, ‖h x‖ ≤ C * Real.exp (ε * ‖x‖) := by
  obtain ⟨C, hC, n, hn⟩ := hg
  refine ⟨C * (1 + (n.factorial : ℝ) / ε^n), by positivity, fun x => ?_⟩
  have hh := (div_le_iff₀ (by positivity : (0 : ℝ) < n.factorial)).mp
    (Real.pow_div_factorial_le_exp (ε * ‖x‖) (by positivity) n)
  have hp : ‖x‖^n ≤ ((n.factorial : ℝ) / ε^n) * Real.exp (ε * ‖x‖) := by
    calc
      ‖x‖^n = (ε * ‖x‖)^n / ε^n := by rw [mul_pow]; field_simp
      _ ≤ (Real.exp (ε * ‖x‖) * n.factorial) / ε^n :=
        div_le_div_of_nonneg_right hh (by positivity)
      _ = _ := by ring
  have he : 1 ≤ Real.exp (ε * ‖x‖) := Real.one_le_exp (by positivity)
  exact (hn x).trans ((mul_le_mul_of_nonneg_left (add_le_add he hp) hC).trans_eq (by ring))

/-- One exponential norm moment controls every polynomially weighted Laplace
integrand on a common smaller closed ball. -/
lemma integrable_laplace_of_exp_norm {μ : Measure E} {r : ℝ} (hr : 0 < r)
    (hμ : Integrable (fun x : E => Real.exp (r * ‖x‖)) μ)
    {h : E → F} (hh : AEStronglyMeasurable h μ) (hg : HasGrowth h)
    {θ : E} (hθ : ‖θ‖ ≤ r / 2) :
    Integrable (fun x => Real.exp (inner ℝ θ x) • h x) μ := by
  obtain ⟨C, hC, hg'⟩ := growth_exp_bound_rate hg (show 0 < r / 2 by positivity)
  apply (hμ.const_mul C).mono'
    (((continuous_const.inner continuous_id).rexp).aestronglyMeasurable.smul hh)
  filter_upwards [] with x
  change ‖Real.exp (inner ℝ θ x) • h x‖ ≤ _
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
  have he := (real_inner_le_norm θ x).trans
    (mul_le_mul_of_nonneg_right hθ (norm_nonneg x))
  have hp := mul_le_mul (Real.exp_le_exp.mpr he) (hg' x)
    (norm_nonneg _) (Real.exp_pos _).le
  exact hp.trans_eq (by
    rw [show Real.exp (r / 2 * ‖x‖) * (C * Real.exp (r / 2 * ‖x‖)) =
      C * (Real.exp (r / 2 * ‖x‖) * Real.exp (r / 2 * ‖x‖)) by ring, ← Real.exp_add]
    congr 2
    ring)

variable [SecondCountableTopology E]

/-- The genuine Fréchet derivative on a fixed open ball, from one exponential
norm moment. No global exponential-moment assumption is used. -/
lemma hasFDerivAt_laplace_of_exp_norm {μ : Measure E} {r : ℝ} (hr : 0 < r)
    (hμ : Integrable (fun x : E => Real.exp (r * ‖x‖)) μ)
    {h : E → F} (hh : Continuous h) (hg : HasGrowth h)
    {θ : E} (hθ : θ ∈ Metric.ball (0 : E) (r / 2)) :
    HasFDerivAt (laplace μ h) (laplace μ (inserted h) θ) θ := by
  have hnθ : ‖θ‖ ≤ r / 2 := (by simpa using hθ : ‖θ‖ < r / 2).le
  obtain ⟨C, hC, hg'⟩ :=
    growth_exp_bound_rate (growth_inserted hg) (show 0 < r / 2 by positivity)
  have hd (x t : E) : HasFDerivAt (fun z : E => Real.exp (inner ℝ z x) • h x)
      (Real.exp (inner ℝ t x) • inserted h x) t := by
    have hh := ((innerSL ℝ x).hasFDerivAt (x := t)).exp.smul_const (h x)
    convert hh using 1
    · funext z; simp only [innerSL_apply_apply,real_inner_comm z x]
    · ext z; simp [inserted,real_inner_comm,smul_smul]
  apply hasFDerivAt_integral_of_dominated_of_fderiv_le
    (F' := fun t x => Real.exp (inner ℝ t x) • inserted h x)
    (bound := fun x => C * Real.exp (r * ‖x‖))
    (Metric.isOpen_ball.mem_nhds hθ)
  · exact Eventually.of_forall fun t =>
      (((continuous_const.inner continuous_id).rexp).smul hh).aestronglyMeasurable
  · exact integrable_laplace_of_exp_norm hr hμ hh.aestronglyMeasurable hg hnθ
  · exact (integrable_laplace_of_exp_norm hr hμ
      (continuous_inserted hh).aestronglyMeasurable (growth_inserted hg) hnθ).aestronglyMeasurable
  · filter_upwards [] with x t ht
    have hnt : ‖t‖ ≤ r / 2 := (by simpa using ht : ‖t‖ < r / 2).le
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
    have he := (real_inner_le_norm t x).trans
      (mul_le_mul_of_nonneg_right hnt (norm_nonneg x))
    have hp := mul_le_mul (Real.exp_le_exp.mpr he) (hg' x)
      (norm_nonneg _) (Real.exp_pos _).le
    exact hp.trans_eq (by
      rw [show Real.exp (r / 2 * ‖x‖) * (C * Real.exp (r / 2 * ‖x‖)) =
        C * (Real.exp (r / 2 * ‖x‖) * Real.exp (r / 2 * ‖x‖)) by ring, ← Real.exp_add]
      congr 2
      ring)
  · exact hμ.const_mul C
  · exact Eventually.of_forall fun x t _ => hd x t

/-- Evaluation of the inserted linear-map integral is the usual inner-product insertion. -/
lemma laplace_inserted_apply_of_exp_norm {μ : Measure E} {r : ℝ} (hr : 0 < r)
    (hμ : Integrable (fun x : E => Real.exp (r * ‖x‖)) μ)
    {h : E → F} (hh : Continuous h) (hg : HasGrowth h)
    {θ : E} (hθ : ‖θ‖ ≤ r / 2) (y : E) :
    laplace μ (inserted h) θ y = laplace μ (fun x => inner ℝ y x • h x) θ := by
  unfold laplace
  rw [ContinuousLinearMap.integral_apply
    (integrable_laplace_of_exp_norm hr hμ (continuous_inserted hh).aestronglyMeasurable
      (growth_inserted hg) hθ)]
  apply integral_congr_ae
  filter_upwards [] with x
  simp [inserted, real_inner_comm]

/-- Directional evaluation of the genuine Fréchet derivative inserts `inner y x`. -/
lemma fderiv_laplace_apply_of_exp_norm {μ : Measure E} {r : ℝ} (hr : 0 < r)
    (hμ : Integrable (fun x : E => Real.exp (r * ‖x‖)) μ)
    {h : E → F} (hh : Continuous h) (hg : HasGrowth h)
    {θ : E} (hθ : θ ∈ Metric.ball (0 : E) (r / 2)) (y : E) :
    fderiv ℝ (laplace μ h) θ y = laplace μ (fun x => inner ℝ y x • h x) θ := by
  rw [(hasFDerivAt_laplace_of_exp_norm hr hμ hh hg hθ).fderiv]
  exact laplace_inserted_apply_of_exp_norm hr hμ hh hg (by exact (by simpa using hθ : ‖θ‖ < r / 2).le) y

/-- All differentiability orders hold on the same ball, independent of the
polynomial weight and its degree. -/
lemma contDiffOn_laplace_of_exp_norm [FiniteDimensional ℝ E]
    {μ : Measure E} {r : ℝ} (hr : 0 < r)
    (hμ : Integrable (fun x : E => Real.exp (r * ‖x‖)) μ)
    {h : E → F} (hh : Continuous h) (hg : HasGrowth h) :
    ContDiffOn ℝ (⊤ : ℕ∞) (laplace μ h) (Metric.ball (0 : E) (r / 2)) := by
  apply contDiffOn_infty.mpr
  intro n
  induction n generalizing h with
  | zero =>
      apply contDiffOn_zero.mpr
      intro θ hθ
      exact (hasFDerivAt_laplace_of_exp_norm hr hμ hh hg hθ).continuousAt.continuousWithinAt
  | succ n ih =>
      rw [Nat.cast_add, Nat.cast_one, contDiffOn_succ_iff_fderiv_of_isOpen Metric.isOpen_ball]
      refine ⟨fun θ hθ =>
        (hasFDerivAt_laplace_of_exp_norm hr hμ hh hg hθ).differentiableAt.differentiableWithinAt,
        by simp, ?_⟩
      apply contDiffOn_clm_apply.mpr
      intro y
      have hhy : Continuous (fun x => inner ℝ y x • h x) :=
        (continuous_const.inner continuous_id).smul hh
      have hgy : HasGrowth (fun x => inner ℝ y x • h x) :=
        (HasGrowth.linear (innerSL ℝ y)).smul hg
      exact (ih hhy hgy).congr fun θ hθ =>
        fderiv_laplace_apply_of_exp_norm hr hμ hh hg hθ y

omit [BorelSpace E] [SecondCountableTopology E] in
@[simp]
lemma laplace_zero (μ : Measure E) (h : E → F) : laplace μ h 0 = ∫ x, h x ∂μ := by
  simp [laplace]

omit [BorelSpace E] [SecondCountableTopology E] in
@[simp]
lemma laplace_one_zero (μ : Measure E) [IsProbabilityMeasure μ] :
    laplace μ (fun _ => (1 : ℝ)) 0 = 1 := by
  simp [laplace]

omit [SecondCountableTopology E] in
lemma laplace_one_pos_of_exp_norm {μ : Measure E} [IsProbabilityMeasure μ]
    {r : ℝ} (hr : 0 < r)
    (hμ : Integrable (fun x : E => Real.exp (r * ‖x‖)) μ)
    {θ : E} (hθ : ‖θ‖ ≤ r / 2) :
    0 < laplace μ (fun _ => (1 : ℝ)) θ := by
  exact (integral_pos_iff_support_of_nonneg (fun x => by
    simp only [smul_eq_mul,mul_one]; exact (Real.exp_pos _).le)
    (integrable_laplace_of_exp_norm hr hμ aestronglyMeasurable_const
      (HasGrowth.const (1 : ℝ)) hθ)).2
    (by simp [Function.support,Real.exp_ne_zero])

variable {ι : Type*}

/-- A list of directions represents repeated insertions; repetitions are allowed. -/
def listWeight (v : ι → E) (l : List ι) (x : E) : ℝ :=
  (l.map (fun i => inner ℝ (v i) x)).prod

omit [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] in
lemma continuous_listWeight (v : ι → E) (l : List ι) : Continuous (listWeight v l) := by
  induction l with
  | nil => exact continuous_const
  | cons i l ih => exact (continuous_const.inner continuous_id).mul ih

omit [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] in
lemma growth_listWeight (v : ι → E) (l : List ι) : HasGrowth (listWeight v l) := by
  induction l with
  | nil => exact HasGrowth.const (1 : ℝ)
  | cons i l ih => exact (HasGrowth.linear (innerSL ℝ (v i))).mul ih

/-- Every actual iterated directional derivative equals the corresponding
weighted integral throughout one fixed open ball. -/
lemma jet_laplace_of_exp_norm {μ : Measure E} {r : ℝ} (hr : 0 < r)
    (hμ : Integrable (fun x : E => Real.exp (r * ‖x‖)) μ)
    {h : E → ℝ} (hh : Continuous h) (hg : HasGrowth h)
    (v : ι → E) (l : List ι) {θ : E} (hθ : θ ∈ Metric.ball (0 : E) (r / 2)) :
    JetCalculus.jet v l (laplace μ h) θ =
      laplace μ (fun x => listWeight v l x * h x) θ := by
  induction l generalizing θ with
  | nil => simp [JetCalculus.jet, listWeight]
  | cons i l ih =>
      have he : JetCalculus.jet v l (laplace μ h) =ᶠ[𝓝 θ]
          laplace μ (fun x => listWeight v l x * h x) := by
        filter_upwards [Metric.isOpen_ball.mem_nhds hθ] with t ht
        exact ih ht
      change fderiv ℝ (JetCalculus.jet v l (laplace μ h)) θ (v i) = _
      rw [he.fderiv_eq]
      trans laplace μ (fun x => inner ℝ (v i) x • (listWeight v l x * h x)) θ
      · exact fderiv_laplace_apply_of_exp_norm hr hμ
          ((continuous_listWeight v l).mul hh) ((growth_listWeight v l).mul hg) hθ (v i)
      congr 1
      funext x
      simp [listWeight, mul_assoc]

/-- The MGF germ's jets at zero are its actual list-indexed moments. -/
lemma jet_laplace_one_zero_of_exp_norm {μ : Measure E} {r : ℝ} (hr : 0 < r)
    (hμ : Integrable (fun x : E => Real.exp (r * ‖x‖)) μ)
    (v : ι → E) (l : List ι) :
    JetCalculus.jet v l (laplace μ (fun _ => (1 : ℝ))) 0 =
      ∫ x, (l.map (fun i => inner ℝ (v i) x)).prod ∂μ := by
  simpa [listWeight] using jet_laplace_of_exp_norm hr hμ continuous_const
    (HasGrowth.const (1 : ℝ)) v l (Metric.mem_ball_self (show 0 < r / 2 by positivity))

end Appell

/-- One common ball supports all continuous polynomially weighted Laplace
transforms and all their genuine first Fréchet derivatives. -/
lemma HasLocalMGF.exists_laplace_regular_radius [FiniteDimensional ℝ E]
    {μ : Measure E} (hμ : HasLocalMGF μ)
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] :
    ∃ ρ : ℝ, 0 < ρ ∧ ∀ h : E → F, Continuous h → Appell.HasGrowth h →
      ContDiffOn ℝ (⊤ : ℕ∞) (Appell.laplace μ h) (Metric.ball 0 ρ) ∧
      ∀ θ ∈ Metric.ball 0 ρ,
        HasFDerivAt (Appell.laplace μ h) (Appell.laplace μ (Appell.inserted h) θ) θ := by
  obtain ⟨r, hr, hi⟩ := hμ.exists_integrable_exp_norm
  exact ⟨r / 2, by positivity, fun h hh hg =>
    ⟨Appell.contDiffOn_laplace_of_exp_norm hr hi hh hg,
      fun θ hθ => Appell.hasFDerivAt_laplace_of_exp_norm hr hi hh hg hθ⟩⟩

/-- Actual local multivariate MGF finiteness gives the moment identity for every
list of directions, including repeated ones. -/
lemma HasLocalMGF.jet_laplace_one_zero [FiniteDimensional ℝ E]
    {μ : Measure E} (hμ : HasLocalMGF μ) {ι : Type*} (v : ι → E) (l : List ι) :
    JetCalculus.jet v l (Appell.laplace μ (fun _ => (1 : ℝ))) 0 =
      ∫ x, (l.map (fun i => inner ℝ (v i) x)).prod ∂μ := by
  obtain ⟨r, hr, hi⟩ := hμ.exists_integrable_exp_norm
  exact Appell.jet_laplace_one_zero_of_exp_norm hr hi v l

end
end AcceleratedLogConcave.Conditional

noncomputable section
open Filter Set
open scoped Topology
namespace AcceleratedLogConcave.Conditional.JetCalculus
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

lemma jet_eventuallyEq {ι : Type*} (v : ι → E) (l : List ι)
    {f g : E → ℝ} {x : E} (h : f =ᶠ[𝓝 x] g) :
    jet v l f =ᶠ[𝓝 x] jet v l g := by
  induction l with
  | nil => exact h
  | cons i l ih =>
    exact ih.fderiv.mono fun y hy => congrArg (fun L : E →L[ℝ] ℝ => L (v i)) hy

lemma exists_smooth_extension {f : E → ℝ} {R : ℝ} (hR : 0 < R)
    (hf : ContDiffOn ℝ (⊤ : ℕ∞) f (Metric.ball 0 R)) :
    ∃ g : E → ℝ, ContDiff ℝ (⊤ : ℕ∞) g ∧ f =ᶠ[𝓝 0] g := by
  let χ : ContDiffBump (0 : E) := ⟨R/4, R/2, by positivity, by linarith⟩
  refine ⟨fun x => χ x * f x, ?_, ?_⟩
  · rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hx : x ∈ Metric.ball (0 : E) R
    · exact χ.contDiffAt.mul (hf.contDiffAt (Metric.isOpen_ball.mem_nhds hx))
    · have hx' : R ≤ ‖x‖ := by simpa using hx
      have hzero : ∀ᶠ y in 𝓝 x, χ y = 0 := by
        have hh : R/2 < ‖x‖ := by linarith
        filter_upwards [(continuous_norm.continuousAt (x := x)).eventually
          (Ioi_mem_nhds hh)] with y hy
        exact χ.zero_of_le_dist (by simpa using hy.le)
      apply (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq
      exact hzero.mono fun y hy => by simp [hy]
  · exact χ.eventuallyEq_one.mono fun x hx => by simp [hx]

lemma exists_positive_smooth_extension {f : E → ℝ} {R : ℝ} (hR : 0 < R)
    (hf : ContDiffOn ℝ (⊤ : ℕ∞) f (Metric.ball 0 R))
    (hpos : ∀ x ∈ Metric.ball (0 : E) R, 0 < f x) :
    ∃ g : E → ℝ, ContDiff ℝ (⊤ : ℕ∞) g ∧
      (∀ x, 0 < g x) ∧ f =ᶠ[𝓝 0] g := by
  have hlog : ContDiffOn ℝ (⊤ : ℕ∞) (fun x => Real.log (f x)) (Metric.ball 0 R) :=
    hf.log fun x hx => (hpos x hx).ne'
  obtain ⟨g, hg, he⟩ := exists_smooth_extension hR hlog
  refine ⟨fun x => Real.exp (g x), hg.exp, fun x => Real.exp_pos _, ?_⟩
  filter_upwards [he, Metric.ball_mem_nhds (0 : E) hR] with x hx hxR
  rw [← hx, Real.exp_log (hpos x hxR)]

end AcceleratedLogConcave.Conditional.JetCalculus

end


noncomputable section
namespace AcceleratedLogConcave.Conditional.JetCalculus
open scoped Topology

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {ι κ : Type*}

lemma mixedJet_add {f : E → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (v : ι → E) (w : κ → E) (l : List ι) (k : List κ) :
    mixedJet v w l k (fun x => f (x.1+x.2)) =
      jet (Sum.elim v w) (l.map Sum.inl++k.map Sum.inr) f 0 := by
  let A : E × E →L[ℝ] E := ContinuousLinearMap.fst ℝ E E+ContinuousLinearMap.snd ℝ E E
  have hh := congrFun (jet_comp_affine hf A 0
    (Sum.elim (fun i => (v i,(0:E))) (fun j => ((0:E),w j)))
    (l.map Sum.inl++k.map Sum.inr)) 0
  have hdir : (fun i => A (Sum.elim (fun i => (v i,(0:E)))
      (fun j => ((0:E),w j)) i))=Sum.elim v w := by
    funext i
    cases i <;> simp [A]
  have hs : ContDiff ℝ (⊤ : ℕ∞) (fun x : E × E => f (x.1+x.2)) :=
    hf.comp (contDiff_fst.add contDiff_snd)
  rw [mixedJet_eq_joint hs]
  rw [hdir] at hh
  simpa [A] using hh

end AcceleratedLogConcave.Conditional.JetCalculus

namespace AcceleratedLogConcave.Conditional.JetCalculus
open scoped Topology

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {ι : Type*}

lemma dir_dir {f : E → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f) (v w : E) :
    dir v (dir w f)=dir w (dir v f) := by
  funext x
  have hs : ContDiff ℝ (⊤ : ℕ∞) (fderiv ℝ f) := hf.fderiv_right (by simp)
  have hd : Differentiable ℝ (fderiv ℝ f) := hs.differentiable (by simp)
  change (fderiv ℝ (fun y => fderiv ℝ f y w) x) v =
    (fderiv ℝ (fun y => fderiv ℝ f y v) x) w
  rw [fderiv_clm_apply (hd x) (differentiableAt_const _),
    fderiv_clm_apply (hd x) (differentiableAt_const _)]
  simpa only [add_apply,ContinuousLinearMap.comp_apply,
    zero_apply,ContinuousLinearMap.map_zero,zero_add,
    ContinuousLinearMap.flip_apply,fderiv_const_apply] using
    ((hf.contDiffAt (x := x)).isSymmSndFDerivAt (by
      simp only [minSmoothness_of_isRCLikeNormedField]
      exact WithTop.coe_le_coe.mpr (show (2:ℕ∞)≤⊤ from le_top))).eq v w

lemma jet_perm {f : E → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (v : ι → E) {l k : List ι} (hp : l.Perm k) : jet v l f=jet v k f := by
  induction hp with
  | nil => rfl
  | cons i hp ih => simp only [jet,ih]
  | swap i j l => exact dir_dir (smooth_jet hf v l) (v j) (v i)
  | trans h1 h2 ih1 ih2 => exact ih1.trans ih2

lemma dir_smul (v : E) (c : ℝ) (f : E → ℝ) :
    dir (c • v) f=fun x => c*dir v f x := by
  funext x
  simp only [dir,map_smul,smul_eq_mul]

lemma jet_smul {f : E → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (v : ι → E) (l : List ι) (c : ℝ) :
    jet (fun i => c • v i) l f=fun x => c^l.length*jet v l f x := by
  induction l with
  | nil => simp [jet]
  | cons i l ih =>
    simp only [jet,ih,List.length_cons]
    rw [dir_const_mul ((smooth_jet hf v l).differentiable (by simp)),dir_smul]
    funext x
    simp only [pow_succ,dir]
    ring

end AcceleratedLogConcave.Conditional.JetCalculus

end


