noncomputable section
open MeasureTheory Filter
open scoped Topology RealInnerProductSpace
namespace AcceleratedLogConcave.Conditional
open JetCalculus
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E]

/-- A globally smooth positive representative of the MGF germ, with its actual
moment derivatives. This is an assembly object, constructed from local MGF
finiteness below, not an additional assumption of the final cumulant theorem. -/
structure MomentModel (μ : Measure E) where
  toFun : E → ℝ
  smooth : ContDiff ℝ (⊤ : ℕ∞) toFun
  positive : ∀ θ, 0 < toFun θ
  jets : ∀ (ι : Type) (v : ι → E) (l : List ι),
    jet v l toFun 0 = ∫ x, (l.map (fun i => inner ℝ (v i) x)).prod ∂μ

namespace MomentModel
variable {μ : Measure E} [IsProbabilityMeasure μ] (M : MomentModel μ)
variable {ι ϑ : Type} [DecidableEq ι] [DecidableEq ϑ]

@[simp] lemma zero : M.toFun 0 = 1 := by
  simpa [jet] using M.jets PEmpty (fun i => nomatch i) []

omit [IsProbabilityMeasure μ] in
lemma jet_moments (v : ι → E) (l : List ι) (hl : l.Nodup) :
    jet v l M.toFun 0 = Appell.moments μ (fun i x => inner ℝ (v i) x) l.toFinset := by
  rw [M.jets]
  apply integral_congr_ae
  filter_upwards [] with x
  exact (List.prod_toFinset _ hl).symm

end MomentModel
end AcceleratedLogConcave.Conditional

namespace AcceleratedLogConcave.Conditional.MomentModel
open JetCalculus Appell
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E]
variable {μ : Measure E} [IsProbabilityMeasure μ] (M : MomentModel μ)
variable {ι : Type} [DecidableEq ι]
lemma filter_toFinset_of_subset (l : List ι) (s : Finset ι) (hs : s ⊆ l.toFinset) :
    (l.filter (fun i => i ∈ s)).toFinset=s := by
  ext i
  simp only [List.mem_toFinset,List.mem_filter,decide_eq_true_eq]
  exact ⟨fun h => h.2,fun h => ⟨List.mem_toFinset.mp (hs h),h⟩⟩

lemma filter_not_toFinset (l : List ι) (s : Finset ι) :
    (l.filter (fun i => i ∉ s)).toFinset=l.toFinset\s := by
  ext i
  simp

lemma jet_inverse_moment
    (v : ι → E) (l : List ι) (hl : l.Nodup) :
    JetCalculus.jet v l (fun θ => (M.toFun θ)⁻¹) 0 =
      Appell.inverseMoment (Appell.moments μ (fun i x => inner ℝ (v i) x)) l.toFinset := by
  let G := M.toFun
  have hMs : ContDiff ℝ (⊤ : ℕ∞) G := M.smooth
  have hMi : ContDiff ℝ (⊤ : ℕ∞) (fun θ => (G θ)⁻¹) :=
    hMs.inv (fun θ => (M.positive θ).ne')
  have hM0 : G 0=1 := by simp [G]
  have hne : ∀ θ, G θ≠0 := fun θ => (M.positive θ).ne'
  induction hn : l.length using Nat.strong_induction_on generalizing l with
  | h n ih =>
    by_cases hl0 : l=[]
    · subst l
      simp [JetCalculus.jet,show M.toFun 0=1 from hM0]
    have hs0 : l.toFinset ≠ ∅ := by simpa using hl0
    have hprod : (fun θ => (G θ)⁻¹*G θ)=(fun _ => (1:ℝ)) := by
      funext θ; exact inv_mul_cancel₀ (hne θ)
    have hj := congrFun (JetCalculus.jet_mul hMi hMs v l hl) 0
    rw [hprod,JetCalculus.jet_const,ite_eq_right hl0] at hj
    have hp := Finset.mem_powerset.mpr (Finset.Subset.refl l.toFinset)
    rw [← Finset.sum_erase_add _ _ hp] at hj
    have hfull : l.filter (fun i => i ∈ l.toFinset)=l := by
      apply List.filter_eq_self.mpr
      intro i hi; simpa using hi
    have hempty : l.filter (fun i => i ∉ l.toFinset)=[] := by simp
    simp only [hfull,hempty,JetCalculus.jet,hM0,mul_one] at hj
    rw [Appell.inverseMoment_nonempty _ hs0]
    have he : (∑ s ∈ l.toFinset.powerset.erase l.toFinset,
        JetCalculus.jet v (l.filter (fun i => i ∈ s)) (fun θ => (G θ)⁻¹) 0 *
        JetCalculus.jet v (l.filter (fun i => i ∉ s)) G 0) =
      ∑ s ∈ l.toFinset.powerset.erase l.toFinset,
        Appell.moments μ (fun i x => inner ℝ (v i) x) (l.toFinset\s) *
          Appell.inverseMoment (Appell.moments μ (fun i x => inner ℝ (v i) x)) s := by
      apply Finset.sum_congr rfl
      intro s hs
      have hsub := Finset.mem_powerset.mp (Finset.mem_erase.mp hs).2
      have hlen : (l.filter (fun i => i ∈ s)).length < n := by
        have hh := Finset.card_lt_card (Finset.ssubset_iff_subset_ne.mpr
          ⟨hsub,(Finset.mem_erase.mp hs).1⟩)
        rw [← filter_toFinset_of_subset l s hsub,
          List.toFinset_card_of_nodup (hl.filter _),List.toFinset_card_of_nodup hl,hn] at hh
        exact hh
      rw [ih _ hlen _ (hl.filter _) rfl,filter_toFinset_of_subset l s hsub,
        M.jet_moments v _ (hl.filter _),filter_not_toFinset,mul_comm]
    change JetCalculus.jet v l (fun θ => (G θ)⁻¹) 0 = _
    rw [he] at hj
    linarith
end AcceleratedLogConcave.Conditional.MomentModel

namespace AcceleratedLogConcave.Conditional.MomentModel
open JetCalculus Appell
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]
variable {μ : Measure E} [IsProbabilityMeasure μ] (M : MomentModel μ)
variable {ι ϑ : Type} [DecidableEq ι] [DecidableEq ϑ]

lemma normalization_jet (hMom : HasMoments μ) {H : E → ℝ}
    (hH : ContDiff ℝ (⊤ : ℕ∞) H) {h : E → ℝ}
    (hh : Continuous h) (hg : HasGrowth h) (v : ι → E)
    (hjets : ∀ l : List ι, jet v l H 0 =
      ∫ x, (l.map (fun i => inner ℝ (v i) x)).prod * h x ∂μ)
    (l : List ι) (hl : l.Nodup) :
    jet v l (fun θ => (M.toFun θ)⁻¹ * H θ) 0 =
      ∫ x, polynomial (moments μ (fun i x => inner ℝ (v i) x))
        l.toFinset (fun i => inner ℝ (v i) x) * h x ∂μ := by
  erw [jet_mul (M.smooth.inv fun θ => (M.positive θ).ne') hH v l hl]
  simp only [polynomial, Finset.sum_mul]
  rw [integral_finsetSum]
  · apply Finset.sum_congr rfl
    intro s hs
    erw [M.jet_inverse_moment v _ (hl.filter _),
      filter_toFinset_of_subset l s (Finset.mem_powerset.mp hs), hjets]
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [] with x
    rw [← List.prod_toFinset _ (hl.filter _), filter_not_toFinset]
    ring
  · intro s hs
    exact (((HasGrowth.const _).mul
      (HasGrowth.prod (l.toFinset \ s) (fun i _ => HasGrowth.linear (innerSL ℝ (v i))))).mul hg).integrable
      ((continuous_const.mul (continuous_finsetProd _
        (fun _ _ => continuous_const.inner continuous_id))).mul hh).aestronglyMeasurable hMom

omit [BorelSpace E] [IsProbabilityMeasure μ] [DecidableEq ι] [DecidableEq ϑ] in
/-- Ordinary repeated derivatives of the smooth representative, concatenated
in the two groups, are actual mixed moments. -/
lemma jet_jet_moments (v : ι → E) (w : ϑ → E) (l : List ι) (k : List ϑ) :
    jet v l (jet w k M.toFun) 0 =
      ∫ x, (l.map (fun i => inner ℝ (v i) x)).prod *
        (k.map (fun i => inner ℝ (w i) x)).prod ∂μ := by
  have he : jet v l (jet w k M.toFun) =
      jet (Sum.elim v w) (l.map Sum.inl ++ k.map Sum.inr) M.toFun := by
    rw [jet_append, jet_map, jet_map]
    rfl
  rw [he, M.jets]
  simp only [List.map_append, List.map_map, List.prod_append, Function.comp_def,
    Sum.elim_inl, Sum.elim_inr]

def rightAppell (w : ϑ → E) (k : List ϑ) (θ : E) : ℝ :=
  ∑ s ∈ k.toFinset.powerset,
    inverseMoment (moments μ (fun i x => inner ℝ (w i) x)) s *
      jet w (k.filter (fun i => i ∉ s)) M.toFun θ

omit [BorelSpace E] [IsProbabilityMeasure μ] in
lemma rightAppell_smooth (w : ϑ → E) (k : List ϑ) :
    ContDiff ℝ (⊤ : ℕ∞) (M.rightAppell w k) := by
  apply ContDiff.sum
  intro s _
  exact contDiff_const.mul (smooth_jet M.smooth _ _)

omit [BorelSpace E] in
lemma normalizedShift_jet (w : ϑ → E) (k : List ϑ) (hk : k.Nodup) (θ : E) :
    jet w k (fun ω => (M.toFun ω)⁻¹ * M.toFun (θ + ω)) 0 = M.rightAppell w k θ := by
  erw [jet_mul (M.smooth.inv fun θ => (M.positive θ).ne')
    (M.smooth.comp (contDiff_const.add contDiff_id)) w k hk]
  apply Finset.sum_congr rfl
  intro s hs
  erw [M.jet_inverse_moment w _ (hk.filter _),
    filter_toFinset_of_subset k s (Finset.mem_powerset.mp hs)]
  congr 1
  have hh := congrFun (jet_comp_affine M.smooth (ContinuousLinearMap.id ℝ E) θ
    w (k.filter (fun i => i ∉ s))) (0 : E)
  convert hh using 1 <;> simp only [ContinuousLinearMap.id_apply, add_zero,
    Function.comp_def, id_eq, add_comm]

omit [DecidableEq ι] in
lemma rightAppell_jets (hMom : HasMoments μ) (v : ι → E) (w : ϑ → E)
    (l : List ι) (k : List ϑ) (hk : k.Nodup) :
    jet v l (M.rightAppell w k) 0 =
      ∫ x, (l.map (fun i => inner ℝ (v i) x)).prod *
        polynomial (moments μ (fun i x => inner ℝ (w i) x))
          k.toFinset (fun i => inner ℝ (w i) x) ∂μ := by
  change jet v l (fun θ => ∑ s ∈ k.toFinset.powerset,
    inverseMoment (moments μ (fun i x => inner ℝ (w i) x)) s *
      jet w (k.filter (fun i => i ∉ s)) M.toFun θ) 0 = _
  rw [jet_sum _ (fun s _ =>
    contDiff_const.mul (smooth_jet M.smooth _ _))]
  simp_rw [jet_const_mul (smooth_jet M.smooth _ _), M.jet_jet_moments]
  simp only [polynomial, Finset.mul_sum]
  rw [integral_finsetSum]
  · apply Finset.sum_congr rfl
    intro s hs
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [] with x
    rw [← List.prod_toFinset _ (hk.filter _), filter_not_toFinset]
    ring
  · intro s hs
    have hp : HasGrowth (fun x : E => (l.map (fun i => inner ℝ (v i) x)).prod) :=
      growth_listWeight v l
    have hc : Continuous (fun x : E => (l.map (fun i => inner ℝ (v i) x)).prod) :=
      continuous_listWeight v l
    exact (hp.mul ((HasGrowth.const _).mul
      (HasGrowth.prod (k.toFinset \ s) (fun i _ => HasGrowth.linear (innerSL ℝ (w i)))))).integrable
      (hc.mul (continuous_const.mul (continuous_finsetProd _
        (fun _ _ => continuous_const.inner continuous_id)))).aestronglyMeasurable hMom

end AcceleratedLogConcave.Conditional.MomentModel

namespace AcceleratedLogConcave.Conditional.MomentModel
open JetCalculus Appell
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]
variable {μ : Measure E} [IsProbabilityMeasure μ] (M : MomentModel μ)
variable {ι ϑ : Type} [DecidableEq ι] [DecidableEq ϑ]

def cross (t : E × E) : ℝ :=
  (M.toFun t.1)⁻¹ * ((M.toFun t.2)⁻¹ * M.toFun (t.1 + t.2))

omit [BorelSpace E] [IsProbabilityMeasure μ] in
lemma cross_smooth : ContDiff ℝ (⊤ : ℕ∞) M.cross := by
  have hi := M.smooth.inv (fun θ => (M.positive θ).ne')
  exact (hi.comp contDiff_fst).mul
    ((hi.comp contDiff_snd).mul (M.smooth.comp (contDiff_fst.add contDiff_snd)))

omit [BorelSpace E] [IsProbabilityMeasure μ] in
lemma cross_pos (t : E × E) : 0 < M.cross t :=
  mul_pos (inv_pos.mpr (M.positive _))
    (mul_pos (inv_pos.mpr (M.positive _)) (M.positive _))

omit [BorelSpace E] in
@[simp] lemma cross_zero : M.cross 0 = 1 := by simp [cross]

omit [BorelSpace E] in
lemma cross_left_zero (t : E) : M.cross (0, t) = 1 := by
  simp only [cross, M.zero, inv_one, one_mul, zero_add]
  exact inv_mul_cancel₀ (M.positive t).ne'

omit [BorelSpace E] in
lemma cross_right_zero (t : E) : M.cross (t, 0) = 1 := by
  simp only [cross, M.zero, inv_one, one_mul, add_zero]
  exact inv_mul_cancel₀ (M.positive t).ne'

lemma mixedJet_cross (hMom : HasMoments μ)
    (v : ι → E) (w : ϑ → E) (l : List ι) (k : List ϑ)
    (hl : l.Nodup) (hk : k.Nodup) :
    mixedJet v w l k M.cross =
      ∫ x, polynomial (moments μ (fun i x => inner ℝ (v i) x)) l.toFinset
        (fun i => inner ℝ (v i) x) *
        polynomial (moments μ (fun i x => inner ℝ (w i) x)) k.toFinset
          (fun i => inner ℝ (w i) x) ∂μ := by
  have hc (θ : E) : ContDiff ℝ (⊤ : ℕ∞) (fun ω =>
      (M.toFun ω)⁻¹ * M.toFun (θ + ω)) :=
    (M.smooth.inv (fun θ => (M.positive θ).ne')).mul
      (M.smooth.comp (contDiff_const.add contDiff_id))
  unfold mixedJet cross
  simp_rw [jet_const_mul (hc _), M.normalizedShift_jet w k hk]
  apply M.normalization_jet hMom (M.rightAppell_smooth w k)
  · exact (polynomial_contDiff _ _ (fun i => innerSL ℝ (w i))).continuous
  · unfold polynomial
    exact HasGrowth.sum _ (fun s _ => (HasGrowth.const _).mul
      (HasGrowth.prod _ (fun i _ => HasGrowth.linear (innerSL ℝ (w i)))))
  · exact fun l => M.rightAppell_jets hMom v w l k hk
  · exact hl

omit [BorelSpace E] [DecidableEq ι] [DecidableEq ϑ] in
lemma mixedJet_reduced_unmixed (v : ι → E) (w : ϑ → E)
    (l : List ι) (k : List ϑ) (hempty : l = [] ∨ k = []) :
    mixedJet v w l k (fun x => M.cross x - 1) = 0 := by
  rcases hempty with rfl | rfl
  · simp only [mixedJet, jet]
    simp_rw [M.cross_left_zero, sub_self]
    simp [jet_const]
  · simp only [mixedJet, jet]
    simp_rw [M.cross_right_zero, sub_self]
    simp [jet_const]

lemma mixedJet_reduced (hMom : HasMoments μ)
    (v : ι → E) (w : ϑ → E) (l : List ι) (k : List ϑ)
    (hl : l.Nodup) (hk : k.Nodup) (hn : ¬(l = [] ∧ k = [])) :
    mixedJet v w l k (fun x => M.cross x - 1) =
      ∫ x, polynomial (moments μ (fun i x => inner ℝ (v i) x)) l.toFinset
        (fun i => inner ℝ (v i) x) *
        polynomial (moments μ (fun i x => inner ℝ (w i) x)) k.toFinset
          (fun i => inner ℝ (w i) x) ∂μ := by
  rw [mixedJet_sub M.cross_smooth contDiff_const, mixedJet_const,
    ite_eq_right hn, sub_zero, M.mixedJet_cross hMom v w l k hl hk]

end AcceleratedLogConcave.Conditional.MomentModel

namespace AcceleratedLogConcave.Conditional
open JetCalculus Appell
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]

/-- Local MGF finiteness constructs a positive smooth representative with all
actual moment jets. The auxiliary global extension imposes no global MGF
finiteness condition on the original law. -/
theorem HasLocalMGF.exists_momentModel {μ : Measure E} [IsProbabilityMeasure μ]
    (hμ : HasLocalMGF μ) :
    ∃ M : MomentModel μ, Appell.laplace μ (fun _ => (1 : ℝ)) =ᶠ[𝓝 0] M.toFun := by
  obtain ⟨r, hr, hi⟩ := hμ.exists_integrable_exp_norm
  obtain ⟨g, hg, hpos, he⟩ := exists_positive_smooth_extension
    (show 0 < r/2 by positivity)
    (contDiffOn_laplace_of_exp_norm hr hi continuous_const (HasGrowth.const (1 : ℝ)))
    (fun θ hθ => laplace_one_pos_of_exp_norm hr hi (by simpa using (Metric.mem_ball.mp hθ).le))
  refine ⟨⟨g, hg, hpos, ?_⟩, he⟩
  intro ι v l
  rw [← (jet_eventuallyEq v l he).eq_of_nhds]
  exact hμ.jet_laplace_one_zero v l

end AcceleratedLogConcave.Conditional

namespace AcceleratedLogConcave.Conditional.Appell
open MeasureTheory
open scoped RealInnerProductSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]
variable {ι ϑ κ N : Type} [Fintype ι] [DecidableEq ι] [Fintype ϑ] [DecidableEq ϑ]
  [Fintype κ] [DecidableEq κ] [Fintype N] [DecidableEq N]
omit [BorelSpace E] [DecidableEq κ] [Fintype N] in
lemma slotPolynomial_fiber (μ : Measure E) (b : OrthonormalBasis κ ℝ E)
    (a : ι → κ) (p : ι → N) (n : N) (x : E) :
    slotPolynomial μ b a (Finset.univ.filter (fun i => p i=n)) x =
      slotPolynomial μ b (fun j : {j : ι // p j=n} => a j) Finset.univ x := by
  have he : (Finset.univ : Finset {j : ι // p j=n}).image Subtype.val =
      Finset.univ.filter (fun j => p j=n) := by ext j; simp
  have hm : moments μ (fun j : {j : ι // p j=n} => coordinate b (a j)) =
      fun t => moments μ (fun j : ι => coordinate b (a j)) (t.image Subtype.val) := by
    funext t
    exact moments_image μ (fun j : ι => coordinate b (a j)) Subtype.val Subtype.val_injective t
  unfold slotPolynomial
  rw [hm]
  simpa only [Function.comp_def,he] using
    (polynomial_image (fun j : {j : ι // p j=n} => j.val) Subtype.val_injective
      (moments μ (fun j : ι => coordinate b (a j))) Finset.univ
      (fun j => coordinate b (a j) x)).symm

omit [MeasurableSpace E] [BorelSpace E] [Fintype N] in
lemma filter_nil_iff_card_fiber (l : List ι) (hall : l.toFinset=Finset.univ)
    (p : ι → N) (n : N) :
    l.filter (fun i => p i=n)=[] ↔ Fintype.card {i : ι // p i=n}=0 := by
  rw [Fintype.card_eq_zero_iff]
  constructor
  · intro h
    refine ⟨fun i => ?_⟩
    have hi : i.val ∈ l := List.mem_toFinset.mp (by rw [hall]; exact Finset.mem_univ _)
    have hh : i.val ∈ l.filter (fun j => p j=n) := List.mem_filter.mpr ⟨hi,by simpa using i.prop⟩
    simp [h] at hh
  · intro h
    apply List.eq_nil_iff_forall_not_mem.mpr
    intro i hi
    have hh := (List.mem_filter.mp hi).2
    exact h.false ⟨i,by simpa using hh⟩
end AcceleratedLogConcave.Conditional.Appell

namespace AcceleratedLogConcave.Conditional.MomentModel
open MeasureTheory Appell JetCalculus
open scoped RealInnerProductSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]
variable {ι ϑ κ N : Type} [Fintype ι] [DecidableEq ι] [Fintype ϑ] [DecidableEq ϑ]
  [Fintype κ] [DecidableEq κ] [Fintype N] [DecidableEq N]
variable {μ : Measure E} [IsProbabilityMeasure μ] (M : MomentModel μ)
omit [DecidableEq κ] [Fintype N] in
lemma mixedJet_reduced_fibers
    (hMom : HasMoments μ) (b : OrthonormalBasis κ ℝ E)
    (a : ι → κ) (c : ϑ → κ) (l : List ι) (k : List ϑ)
    (hl : l.Nodup) (hlall : l.toFinset=Finset.univ)
    (hk : k.Nodup) (hkall : k.toFinset=Finset.univ)
    (p : ι → N) (q : ϑ → N) (n : N) :
    JetCalculus.mixedJet (fun i => b (a i)) (fun j => b (c j))
      (l.filter (fun i => p i=n)) (k.filter (fun j => q j=n)) (fun x => M.cross x-1) =
      reducedCrossMoment μ b (fun i : {i : ι // p i=n} => a i)
        (fun j : {j : ϑ // q j=n} => c j) := by
  unfold reducedCrossMoment
  split_ifs with hempty
  · apply M.mixedJet_reduced_unmixed
    simpa only [filter_nil_iff_card_fiber l hlall p n,
      filter_nil_iff_card_fiber k hkall q n] using hempty
  · rw [M.mixedJet_reduced hMom _ _ _ _ (hl.filter _) (hk.filter _)]
    · change (∫ x, slotPolynomial μ b a (l.filter (fun i => p i=n)).toFinset x *
        slotPolynomial μ b c (k.filter (fun j => q j=n)).toFinset x ∂μ)=_
      simp only [List.toFinset_filter,decide_eq_true_eq,hlall,hkall]
      simp only [slotPolynomial_fiber,crossMoment]
    · intro h
      apply hempty
      exact Or.inl ((filter_nil_iff_card_fiber l hlall p n).mp h.1)

omit [DecidableEq κ] in

lemma mixedJet_reduced_pow
    (hMom : HasMoments μ) (b : OrthonormalBasis κ ℝ E)
    (a : ι → κ) (c : ϑ → κ) (l : List ι) (k : List ϑ)
    (hl : l.Nodup) (hlall : l.toFinset=Finset.univ)
    (hk : k.Nodup) (hkall : k.toFinset=Finset.univ) (m : ℕ) :
    JetCalculus.mixedJet (fun i => b (a i)) (fun j => b (c j)) l k
      (fun x => (M.cross x-1)^(m+1)) =
      ∑ p : ι → Fin (m+1), ∑ q : ϑ → Fin (m+1), crossBlockProduct μ b p q a c := by
  have hp : (fun x => (M.cross x-1)^(m+1)) =
      (fun x => ∏ _i : Fin (m+1), (M.cross x-1)) := by funext x; simp
  rw [hp,JetCalculus.mixedJet_prod_sum (fun _ => M.cross_smooth.sub contDiff_const)
    (0 : Fin (m+1)) _ _ l k hl hlall hk hkall]
  simp only [crossBlockProduct,M.mixedJet_reduced_fibers hMom b a c l k hl hlall hk hkall]
end AcceleratedLogConcave.Conditional.MomentModel

namespace AcceleratedLogConcave.Conditional.Appell
open MeasureTheory
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E]
variable {ι ϑ κ N : Type*} [Fintype ι] [DecidableEq ι] [Fintype ϑ] [DecidableEq ϑ]
  [Fintype κ] [DecidableEq κ] [Fintype N] [DecidableEq N]

omit [DecidableEq κ] in
lemma crossBlockProduct_zero_of_card_lt (μ : Measure E) (b : OrthonormalBasis κ ℝ E)
    (p : ι → N) (q : ϑ → N) (a : ι → κ) (c : ϑ → κ)
    (h : Fintype.card ι < Fintype.card N ∨ Fintype.card ϑ < Fintype.card N) :
    crossBlockProduct μ b p q a c = 0 := by
  rcases h with h | h
  · have hn : ¬ Function.Surjective p := fun hp =>
      (not_le_of_gt h) (Fintype.card_le_of_surjective p hp)
    simp only [Function.Surjective, not_forall, not_exists] at hn
    obtain ⟨i, hi⟩ := hn
    have : IsEmpty {j : ι // p j = i} := ⟨fun j => hi j.val j.prop⟩
    apply Finset.prod_eq_zero (Finset.mem_univ i)
    simp [reducedCrossMoment]
  · have hn : ¬ Function.Surjective q := fun hq =>
      (not_le_of_gt h) (Fintype.card_le_of_surjective q hq)
    simp only [Function.Surjective, not_forall, not_exists] at hn
    obtain ⟨i, hi⟩ := hn
    have : IsEmpty {j : ϑ // q j = i} := ⟨fun j => hi j.val j.prop⟩
    apply Finset.prod_eq_zero (Finset.mem_univ i)
    simp [reducedCrossMoment]

omit [DecidableEq κ] in
lemma crossBlockSum_zero_of_gt_min (μ : Measure E) (b : OrthonormalBasis κ ℝ E)
    (a : ι → κ) (c : ϑ → κ) {m : ℕ}
    (hm : min (Fintype.card ι) (Fintype.card ϑ) < m) :
    crossBlockSum (N := Fin m) μ b a c = 0 := by
  apply Finset.sum_eq_zero
  intro p _
  apply Finset.sum_eq_zero
  intro q _
  apply crossBlockProduct_zero_of_card_lt
  simpa using (min_lt_iff.mp hm)

lemma sum_range_shift (f : ℕ → ℝ) (n : ℕ) :
    ∑ m ∈ Finset.range n, f (m+1) = ∑ m ∈ Finset.Icc 1 n, f m := by
  apply Finset.sum_bij (fun m _ => m+1)
  · intro m hm
    simp only [Finset.mem_range] at hm
    simp only [Finset.mem_Icc]
    omega
  · intro a _ b _ hab
    omega
  · intro b hb
    simp only [Finset.mem_Icc] at hb
    exact ⟨b-1, Finset.mem_range.mpr (by omega), by omega⟩
  · intro m _
    rfl

omit [DecidableEq κ] in
lemma mixedCumulant_eq_range (μ : Measure E) (b : OrthonormalBasis κ ℝ E)
    (a : ι → κ) (c : ϑ → κ) :
    mixedCumulant μ b a c =
      ∑ m ∈ Finset.range (Fintype.card ι + Fintype.card ϑ),
        ((-1 : ℝ)^m / (m+1)) * crossBlockSum (N := Fin (m+1)) μ b a c := by
  let f : ℕ → ℝ := fun m => ((-1 : ℝ)^(m+1) / m) * crossBlockSum (N := Fin m) μ b a c
  have he : ∀ m, ((-1 : ℝ)^m / (m+1)) * crossBlockSum (N := Fin (m+1)) μ b a c = f (m+1) := by
    intro m
    dsimp [f]
    simp only [Nat.cast_add, Nat.cast_one, pow_succ]
    ring
  simp_rw [he]
  rw [sum_range_shift]
  change ∑ m ∈ Finset.Icc 1 (min (Fintype.card ι) (Fintype.card ϑ)), f m = _
  apply Finset.sum_subset
  · intro m hm
    simp only [Finset.mem_Icc] at hm ⊢
    omega
  · intro m hm hnot
    have hm' : min (Fintype.card ι) (Fintype.card ϑ) < m := by
      simp only [Finset.mem_Icc] at hm hnot
      omega
    simp [f, crossBlockSum_zero_of_gt_min μ b a c hm']

end AcceleratedLogConcave.Conditional.Appell

namespace AcceleratedLogConcave.Conditional.MomentModel
open MeasureTheory Appell JetCalculus
open scoped RealInnerProductSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]
variable {ι ϑ κ : Type} [Fintype ι] [DecidableEq ι] [Fintype ϑ] [DecidableEq ϑ]
  [Fintype κ] [DecidableEq κ]
variable {μ : Measure E} [IsProbabilityMeasure μ] (M : MomentModel μ)

omit [DecidableEq κ] in
lemma mixedJet_log_cross (hMom : HasMoments μ) (b : OrthonormalBasis κ ℝ E)
    (a : ι → κ) (c : ϑ → κ) (l : List ι) (k : List ϑ)
    (hl : l.Nodup) (hlall : l.toFinset = Finset.univ)
    (hk : k.Nodup) (hkall : k.toFinset = Finset.univ) :
    mixedJet (fun i => b (a i)) (fun j => b (c j)) l k
      (fun x => Real.log (M.cross x)) = mixedCumulant μ b a c := by
  have hlc : l.length = Fintype.card ι := by
    rw [← List.toFinset_card_of_nodup hl, hlall, Finset.card_univ]
  have hkc : k.length = Fintype.card ϑ := by
    rw [← List.toFinset_card_of_nodup hk, hkall, Finset.card_univ]
  rw [mixedJet_logTrunc M.cross_smooth M.cross_pos M.cross_zero _ _ _ _ hl hk,
    hlc, hkc, mixedCumulant_eq_range]
  unfold logTrunc
  rw [mixedJet_sum _ (fun m _ => contDiff_const.mul
    ((M.cross_smooth.sub contDiff_const).pow _))]
  apply Finset.sum_congr rfl
  intro m hm
  rw [mixedJet_const_mul ((M.cross_smooth.sub contDiff_const).pow _),
    M.mixedJet_reduced_pow hMom b a c l k hl hlall hk hkall]
  rfl

omit [BorelSpace E] [IsProbabilityMeasure μ] in
lemma log_cross (x : E × E) :
    Real.log (M.cross x) = Real.log (M.toFun (x.1 + x.2)) -
      Real.log (M.toFun x.1) - Real.log (M.toFun x.2) := by
  simp only [cross, Real.log_mul (inv_ne_zero (M.positive _).ne')
    (mul_ne_zero (inv_ne_zero (M.positive _).ne') (M.positive _).ne'),
    Real.log_mul (inv_ne_zero (M.positive _).ne') (M.positive _).ne', Real.log_inv]
  ring

omit [DecidableEq κ] in
lemma mixedJet_log_toFun (hMom : HasMoments μ) (b : OrthonormalBasis κ ℝ E)
    (a : ι → κ) (c : ϑ → κ) (l : List ι) (k : List ϑ)
    (hl : l.Nodup) (hlall : l.toFinset = Finset.univ)
    (hk : k.Nodup) (hkall : k.toFinset = Finset.univ)
    (hlne : l ≠ []) (hkne : k ≠ []) :
    mixedJet (fun i => b (a i)) (fun j => b (c j)) l k
      (fun x => Real.log (M.toFun (x.1 + x.2))) = mixedCumulant μ b a c := by
  have hs := M.smooth.log (fun θ => (M.positive θ).ne')
  have hsA : ContDiff ℝ (⊤ : ℕ∞) (fun x : E × E => Real.log (M.toFun (x.1+x.2))) :=
    hs.comp (contDiff_fst.add contDiff_snd)
  have hsL : ContDiff ℝ (⊤ : ℕ∞) (fun x : E × E => Real.log (M.toFun x.1)) :=
    hs.comp contDiff_fst
  have hsR : ContDiff ℝ (⊤ : ℕ∞) (fun x : E × E => Real.log (M.toFun x.2)) :=
    hs.comp contDiff_snd
  have hh := M.mixedJet_log_cross hMom b a c l k hl hlall hk hkall
  simp_rw [M.log_cross] at hh
  rw [mixedJet_sub (hsA.sub hsL) hsR, mixedJet_sub hsA hsL,
    mixedJet_fst (fun θ => Real.log (M.toFun θ)) _ _ _ _ hkne,
    mixedJet_snd (fun θ => Real.log (M.toFun θ)) _ _ _ _ hlne, sub_zero, sub_zero] at hh
  exact hh

omit [DecidableEq κ] in
lemma jet_log_toFun (hMom : HasMoments μ) (b : OrthonormalBasis κ ℝ E)
    (a : ι → κ) (c : ϑ → κ) (l : List ι) (k : List ϑ)
    (hl : l.Nodup) (hlall : l.toFinset = Finset.univ)
    (hk : k.Nodup) (hkall : k.toFinset = Finset.univ)
    (hlne : l ≠ []) (hkne : k ≠ []) (o : List (ι ⊕ ϑ))
    (ho : o.Perm (l.map Sum.inl ++ k.map Sum.inr)) :
    jet (Sum.elim (fun i => b (a i)) (fun j => b (c j))) o
      (fun θ => Real.log (M.toFun θ)) 0 = mixedCumulant μ b a c := by
  have hs := M.smooth.log (fun θ => (M.positive θ).ne')
  rw [jet_perm hs _ ho, ← mixedJet_add hs]
  exact M.mixedJet_log_toFun hMom b a c l k hl hlall hk hkall hlne hkne

end AcceleratedLogConcave.Conditional.MomentModel

namespace AcceleratedLogConcave.Conditional
open MeasureTheory Appell JetCalculus
open scoped RealInnerProductSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
variable {ι ϑ κ : Type} [Fintype ι] [DecidableEq ι] [Fintype ϑ] [DecidableEq ϑ]
  [Fintype κ] [DecidableEq κ]

omit [DecidableEq κ] in
/-- The actual local log-MGF derivative, in any order of the prescribed slots,
is exactly the finite Appell mixed cumulant coefficient. -/
theorem jet_log_laplace_eq_mixedCumulant {μ : Measure E} [IsProbabilityMeasure μ]
    (hμ : HasLocalMGF μ) (b : OrthonormalBasis κ ℝ E)
    (a : ι → κ) (c : ϑ → κ) (l : List ι) (k : List ϑ)
    (hl : l.Nodup) (hlall : l.toFinset = Finset.univ)
    (hk : k.Nodup) (hkall : k.toFinset = Finset.univ)
    (hlne : l ≠ []) (hkne : k ≠ []) (o : List (ι ⊕ ϑ))
    (ho : o.Perm (l.map Sum.inl ++ k.map Sum.inr)) :
    jet (Sum.elim (fun i => b (a i)) (fun j => b (c j))) o
      (fun θ => Real.log (laplace μ (fun _ => (1 : ℝ)) θ)) 0 =
      mixedCumulant μ b a c := by
  obtain ⟨M, he⟩ := hμ.exists_momentModel
  have hlog := he.mono fun θ hθ => congrArg Real.log hθ
  rw [(jet_eventuallyEq _ o hlog).eq_of_nhds]
  exact M.jet_log_toFun (hμ.hasMoments b) b a c l k hl hlall hk hkall hlne hkne o ho

/-- Cumulant coefficients are genuine directional derivatives of the local
log-MGF. All slots, including a designated output slot if one is used, carry
ordinary Euclidean coefficient norm. -/
def cumulantTensor {Slot : Type} [Fintype Slot] [DecidableEq Slot] {D : ℕ}
    (μ : Measure E) (b : OrthonormalBasis (Fin D) ℝ E) : Tensor.Coeff Slot D :=
  WithLp.toLp 2 (fun a => jet (fun i => b (a i)) (Finset.univ.toList : List Slot)
    (fun θ => Real.log (laplace μ (fun _ => (1 : ℝ)) θ)) 0)

lemma cumulantTensor_unfold {Slot : Type} [Fintype Slot] [DecidableEq Slot] {D : ℕ}
    {μ : Measure E} [IsProbabilityMeasure μ] (hμ : HasLocalMGF μ)
    (b : OrthonormalBasis (Fin D) ℝ E) (S : Finset Slot) (hS : Tensor.NontrivialSplit S)
    (a : S → Fin D) (c : {i : Slot // i ∉ S} → Fin D) :
    Tensor.unfoldEquiv D S (cumulantTensor μ b) a c = mixedCumulant μ b a c := by
  classical
  let e : S ⊕ {i : Slot // i ∉ S} ≃ Slot := Equiv.sumCompl (fun i => i ∈ S)
  let l : List S := Finset.univ.toList
  let k : List {i : Slot // i ∉ S} := Finset.univ.toList
  let o : List (S ⊕ {i : Slot // i ∉ S}) := (Finset.univ.toList : List Slot).map e.symm
  have hl : l.Nodup := Finset.nodup_toList _
  have hk : k.Nodup := Finset.nodup_toList _
  have hlall : l.toFinset = Finset.univ := Finset.toList_toFinset _
  have hkall : k.toFinset = Finset.univ := Finset.toList_toFinset _
  have hlne : l ≠ [] := by
    intro hh
    obtain ⟨i, hi⟩ := hS.1
    have : (⟨i,hi⟩ : S) ∈ l := by simp [l]
    simp [hh] at this
  have hkne : k ≠ [] := by
    intro hh
    obtain ⟨i, hi⟩ := hS.2
    have hi' : i ∉ S := Finset.mem_compl.mp hi
    have : (⟨i,hi'⟩ : {i : Slot // i ∉ S}) ∈ k := by simp [k]
    simp [hh] at this
  have ho : o.Perm (l.map Sum.inl ++ k.map Sum.inr) := by
    apply (List.perm_ext_iff_of_nodup ((Finset.nodup_toList _).map e.symm.injective)
      (nodup_sum_append hl hk)).mpr
    intro i
    constructor
    · intro _
      cases i <;> simp [l,k]
    · intro _
      apply List.mem_map.mpr
      exact ⟨e i, by simp, e.symm_apply_apply i⟩
  have h := jet_log_laplace_eq_mixedCumulant hμ b a c l k hl hlall hk hkall hlne hkne o ho
  rw [show o = (Finset.univ.toList : List Slot).map e.symm from rfl, jet_map] at h
  have hd : (fun i => b ((Tensor.assignmentEquiv D S).symm (a,c) i)) =
      (Sum.elim (fun j => b (a j)) (fun j => b (c j))) ∘ e.symm := by
    funext i
    by_cases hi : i ∈ S
    · simp [Tensor.assignmentEquiv, e, Equiv.sumCompl_symm_apply_of_pos hi, hi]
    · simp [Tensor.assignmentEquiv, e, Equiv.sumCompl_symm_apply_of_neg hi, hi]
  change jet (fun i => b ((Tensor.assignmentEquiv D S).symm (a,c) i))
    (Finset.univ.toList : List Slot)
    (fun θ => Real.log (laplace μ (fun _ => (1 : ℝ)) θ)) 0 = _
  rw [hd]
  exact h

/-- Poincaré controls every nonempty proper unfolding of the actual cumulant
tensor, with the sharp factorial constant. The formula remains valid at β=0. -/
theorem cumulantTensor_splitNorm_le {Slot : Type} [Fintype Slot] [DecidableEq Slot] {D : ℕ}
    {μ : Measure E} [IsProbabilityMeasure μ] (hμ : HasLocalMGF μ)
    {β : ℝ} (hβ : 0 ≤ β) (hP : HasPolynomialPoincare μ β)
    (b : OrthonormalBasis (Fin D) ℝ E) (S : Finset Slot) (hS : Tensor.NontrivialSplit S) :
    Tensor.splitNorm D S (cumulantTensor μ b) ≤
      ((Fintype.card Slot - 1).factorial : ℝ) * (Real.sqrt β) ^ Fintype.card Slot := by
  classical
  have : Nonempty S := by obtain ⟨i,hi⟩ := hS.1; exact ⟨⟨i,hi⟩⟩
  have : Nonempty {i : Slot // i ∉ S} := by
    obtain ⟨i,hi⟩ := hS.2; exact ⟨⟨i,Finset.mem_compl.mp hi⟩⟩
  have hc : Fintype.card S + Fintype.card {i : Slot // i ∉ S} = Fintype.card Slot := by
    simpa only [Fintype.card_sum] using Fintype.card_congr (Equiv.sumCompl (fun i => i ∈ S))
  have he : Tensor.unfoldEquiv D S (cumulantTensor μ b) =
      mixedCumulant μ b (ι := S) (ϑ := {i : Slot // i ∉ S}) := by
    ext a c
    exact cumulantTensor_unfold hμ b S hS a c
  change ‖Tensor.matrixCLMEquiv (Tensor.unfoldEquiv D S (cumulantTensor μ b))‖ ≤ _
  rw [he]
  simpa only [hc] using mixedCumulant_operator_norm_le_of_localMGF μ hμ hβ hP b
    (ι := S) (ϑ := {i : Slot // i ∉ S})

end AcceleratedLogConcave.Conditional

namespace AcceleratedLogConcave.Conditional
open MeasureTheory Appell JetCalculus InnerProductSpace
open scoped RealInnerProductSpace ENNReal
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]

/-- The literal normalized posterior has all real exponential-linear moments.
This is derived from its affine lower bound, even when m=0 and the base law
has infinite partition function. -/
theorem posterior_integrable_exp_inner {F : E → ℝ} {m t : ℝ}
    (hF : ContDiff ℝ 2 F) (hm : 0 ≤ m) (ht : 0 < t) (y θ : E)
    (hH : ∀ z v, m * ‖v‖ ^ 2 ≤ fderiv ℝ (fderiv ℝ F) z v v) :
    Integrable (fun x => Real.exp (inner ℝ θ x))
      ((∫⁻ x : E, ENNReal.ofReal (Real.exp (-(F x + ‖x-y‖^2/(2*t)))))⁻¹ •
        volume.withDensity (fun x : E => ENNReal.ofReal (Real.exp (-(F x + ‖x-y‖^2/(2*t)))))) := by
  let g : E := (toDual ℝ E).symm (fderiv ℝ F 0)
  have hlower (x : E) : F 0 + inner ℝ g x ≤ F x := by
    have h := Gibbs.quadratic_lower_bound_of_hessian_lower hF hH x
    have hn : 0 ≤ m / 2 * ‖x‖^2 := by positivity
    simpa only [g, toDual_symm_apply] using (le_trans (by linarith :
      F 0 + fderiv ℝ F 0 x ≤ F 0 + fderiv ℝ F 0 x + m/2*‖x‖^2) h)
  have hshift : Integrable (fun x => Real.exp (-((F x - inner ℝ θ x) + ‖x-y‖^2/(2*t)))) := by
    apply Gibbs.integrable_posterior_of_affine_lower_bound
      (hF.continuous.measurable.sub (by fun_prop)) (g-θ) y ht (a := F 0)
    intro x
    rw [inner_sub_left]
    change F 0 + (inner ℝ g x - inner ℝ θ x) ≤ F x - inner ℝ θ x
    linarith [hlower x]
  have hI := Gibbs.integrable_posterior_of_hessian_lower hF hm ht y hH
  apply Integrable.smul_measure _ (ENNReal.inv_ne_top.mpr (Gibbs.lintegral_exp_neg_pos hI).ne')
  apply (integrable_withDensity_iff_integrable_smul'
    (show Measurable (fun x : E => ENNReal.ofReal (Real.exp (-(F x + ‖x-y‖^2/(2*t))))) by
      have hFm := hF.continuous.measurable
      fun_prop) (by simp)).mpr
  convert hshift using 1
  funext x
  simp only [ENNReal.toReal_ofReal (Real.exp_pos _).le, smul_eq_mul, ← Real.exp_add]
  congr 1
  ring

theorem posterior_hasLocalMGF {F : E → ℝ} {m t : ℝ}
    (hF : ContDiff ℝ 2 F) (hm : 0 ≤ m) (ht : 0 < t) (y : E)
    (hH : ∀ z v, m * ‖v‖ ^ 2 ≤ fderiv ℝ (fderiv ℝ F) z v v) :
    HasLocalMGF
      ((∫⁻ x : E, ENNReal.ofReal (Real.exp (-(F x + ‖x-y‖^2/(2*t)))))⁻¹ •
        volume.withDensity (fun x : E => ENNReal.ofReal (Real.exp (-(F x + ‖x-y‖^2/(2*t)))))) :=
  Filter.Eventually.of_forall fun θ => posterior_integrable_exp_inner hF hm ht y θ hH

/-- Concrete posterior specialization. All moment, local-MGF and Poincaré
premises are discharged for the exact normalized law. -/
theorem posterior_cumulantTensor_splitNorm_le {Slot : Type} [Fintype Slot] [DecidableEq Slot]
    {D : ℕ} {F : E → ℝ} {m L t : ℝ}
    (hF : ContDiff ℝ 2 F) (hm : 0 ≤ m) (ht : 0 < t) (y : E)
    (hlower : ∀ z v, m * ‖v‖ ^ 2 ≤ fderiv ℝ (fderiv ℝ F) z v v)
    (hupper : ∀ z v, fderiv ℝ (fderiv ℝ F) z v v ≤ L * ‖v‖ ^ 2)
    (b : OrthonormalBasis (Fin D) ℝ E) (S : Finset Slot) (hS : Tensor.NontrivialSplit S) :
    Tensor.splitNorm D S (cumulantTensor
      ((∫⁻ x : E, ENNReal.ofReal (Real.exp (-(F x + ‖x-y‖^2/(2*t)))))⁻¹ •
        volume.withDensity (fun x : E => ENNReal.ofReal (Real.exp (-(F x + ‖x-y‖^2/(2*t)))))) b) ≤
      ((Fintype.card Slot - 1).factorial : ℝ) *
        (Real.sqrt ((m+t⁻¹)⁻¹)) ^ Fintype.card Slot := by
  have := Gibbs.normalized_posterior_isProbabilityMeasure_of_hessian_lower hF hm ht y hlower
  exact cumulantTensor_splitNorm_le (posterior_hasLocalMGF hF hm ht y hlower)
    (by positivity) (posterior_polynomialPoincare hF hm ht y hlower hupper) b S hS

lemma sqrt_pow_eq_rpow {β : ℝ} (hβ : 0 ≤ β) (n : ℕ) :
    (Real.sqrt β)^n = β ^ ((n : ℝ)/2) := by
  rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hβ]
  congr 1
  ring

/-- The manuscript's β^(n/2) formulation, with extended endpoint β=0. -/
theorem cumulantTensor_splitNorm_le_rpow {Slot : Type} [Fintype Slot] [DecidableEq Slot]
    {D : ℕ} {μ : Measure E} [IsProbabilityMeasure μ] (hμ : HasLocalMGF μ)
    {β : ℝ} (hβ : 0 ≤ β) (hP : HasPolynomialPoincare μ β)
    (b : OrthonormalBasis (Fin D) ℝ E) (S : Finset Slot) (hS : Tensor.NontrivialSplit S) :
    Tensor.splitNorm D S (cumulantTensor μ b) ≤
      ((Fintype.card Slot - 1).factorial : ℝ) * β ^ ((Fintype.card Slot : ℝ)/2) := by
  simpa only [sqrt_pow_eq_rpow hβ] using cumulantTensor_splitNorm_le hμ hβ hP b S hS

/-- A zero polynomial-Poincaré constant annihilates every nontrivial cumulant
unfolding. No inverse or division by β is taken. -/
theorem cumulantTensor_splitNorm_eq_zero {Slot : Type} [Fintype Slot] [DecidableEq Slot]
    {D : ℕ} {μ : Measure E} [IsProbabilityMeasure μ] (hμ : HasLocalMGF μ)
    (hP : HasPolynomialPoincare μ 0) (b : OrthonormalBasis (Fin D) ℝ E)
    (S : Finset Slot) (hS : Tensor.NontrivialSplit S) :
    Tensor.splitNorm D S (cumulantTensor μ b) = 0 := by
  have h := cumulantTensor_splitNorm_le hμ (le_refl 0) hP b S hS
  have : Nonempty Slot := by obtain ⟨i,_⟩ := hS.1; exact ⟨i⟩
  have hn : Fintype.card Slot ≠ 0 := Fintype.card_ne_zero
  simp only [Real.sqrt_zero, zero_pow hn, mul_zero] at h
  exact le_antisymm h (Tensor.splitNorm_nonneg D S _)

end AcceleratedLogConcave.Conditional

namespace AcceleratedLogConcave.Conditional.JetCalculus
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {ι : Type*}
lemma jet_linear_eq_zero (L : E →L[ℝ] ℝ) (v : ι → E) (l : List ι)
    (hl : 2 ≤ l.length) : jet v l L = fun _ => 0 := by
  induction l with
  | nil => simp at hl
  | cons i l ih =>
    by_cases hh : 2 ≤ l.length
    · rw [jet, ih hh]
      funext x
      simp [dir]
    · have hn : l.length = 1 := by simp only [List.length_cons] at hl; omega
      cases l with
      | nil => simp at hn
      | cons j t =>
        have ht : t = [] := List.length_eq_zero_iff.mp (by simp only [List.length_cons] at hn; omega)
        subst t
        have hd : dir (v j) L = fun _ => L (v j) := by
          funext z
          exact congrArg (fun A : E →L[ℝ] ℝ => A (v j)) (L.hasFDerivAt (x := z)).fderiv
        funext x
        change fderiv ℝ (dir (v j) L) x (v i) = 0
        rw [hd]
        simp
end AcceleratedLogConcave.Conditional.JetCalculus

namespace AcceleratedLogConcave.Conditional
open MeasureTheory Appell JetCalculus
open scoped RealInnerProductSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]

lemma laplace_map_sub (μ : Measure E) (c θ : E) :
    laplace (μ.map (fun x => x-c)) (fun _ => (1 : ℝ)) θ =
      Real.exp (-inner ℝ θ c) * laplace μ (fun _ => (1 : ℝ)) θ := by
  simp only [laplace, smul_eq_mul, mul_one]
  rw [integral_map (by fun_prop : AEMeasurable (fun x : E => x-c) μ)
    (by fun_prop : AEStronglyMeasurable (fun x : E => Real.exp (inner ℝ θ x)) _),
    ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with x
  rw [inner_sub_right, ← Real.exp_add]
  congr 1
  ring

/-- Centering translates the actual law and leaves every cumulant of order at
least two unchanged. In particular the centering vector may be the actual mean. -/
theorem cumulantTensor_map_sub {Slot : Type} [Fintype Slot] [DecidableEq Slot] {D : ℕ}
    {μ : Measure E} [IsProbabilityMeasure μ] (hμ : HasLocalMGF μ)
    (b : OrthonormalBasis (Fin D) ℝ E) (c : E) (hn : 2 ≤ Fintype.card Slot) :
    cumulantTensor (Slot := Slot) (μ.map (fun x => x-c)) b = cumulantTensor μ b := by
  obtain ⟨M, he⟩ := hμ.exists_momentModel
  have hlog : (fun θ => Real.log (laplace μ (fun _ => (1 : ℝ)) θ)) =ᶠ[𝓝 0]
      fun θ => Real.log (M.toFun θ) := he.mono fun θ hθ => congrArg Real.log hθ
  have hshift : (fun θ => Real.log (laplace (μ.map (fun x => x-c)) (fun _ => (1 : ℝ)) θ)) =ᶠ[𝓝 0]
      fun θ => Real.log (M.toFun θ) - inner ℝ θ c := by
    filter_upwards [he] with θ hθ
    rw [laplace_map_sub, hθ, Real.log_mul (Real.exp_ne_zero _) (M.positive θ).ne',
      Real.log_exp]
    ring
  ext a
  change jet (fun i => b (a i)) (Finset.univ.toList : List Slot)
    (fun θ => Real.log (laplace (μ.map (fun x => x-c)) (fun _ => (1 : ℝ)) θ)) 0 =
      jet (fun i => b (a i)) (Finset.univ.toList : List Slot)
        (fun θ => Real.log (laplace μ (fun _ => (1 : ℝ)) θ)) 0
  rw [(jet_eventuallyEq _ _ hshift).eq_of_nhds, (jet_eventuallyEq _ _ hlog).eq_of_nhds]
  have hlin : (fun θ => inner ℝ θ c) = innerSL ℝ c := by
    funext θ
    simp [real_inner_comm]
  have hlin' (θ : E) : inner ℝ θ c = innerSL ℝ c θ := congrFun hlin θ
  simp_rw [hlin']
  rw [jet_sub (M.smooth.log (fun θ => (M.positive θ).ne')) (innerSL ℝ c).contDiff,
    jet_linear_eq_zero (innerSL ℝ c) _ _ (by simpa using hn)]
  simp only [sub_zero]

end AcceleratedLogConcave.Conditional

