variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]

omit [MeasurableSpace E] [BorelSpace E] in
lemma IsPolynomial.hasGrowth {f : E → ℝ} (hf : IsPolynomial f) : Appell.HasGrowth f := by
  induction hf with
  | const c => exact Appell.HasGrowth.const c
  | linear L => exact Appell.HasGrowth.linear L
  | add _ _ hf hg => exact hf.add hg
  | mul _ _ hf hg => exact hf.mul hg

omit [MeasurableSpace E] [BorelSpace E] in
lemma IsPolynomial.fderiv_hasGrowth {f : E → ℝ} (hf : IsPolynomial f) :
    Appell.HasGrowth (fun x => fderiv ℝ f x) := by
  induction hf with
  | const c => simpa using Appell.HasGrowth.const (E := E) (0 : E →L[ℝ] ℝ)
  | linear L => simpa using Appell.HasGrowth.const (E := E) L
  | @add f g hf hg ihf ihg =>
    have he : (fun x => fderiv ℝ (fun y => f y + g y) x) =
        fun x => fderiv ℝ f x + fderiv ℝ g x := by
      funext x
      exact fderiv_fun_add (hf.contDiff.differentiable (by simp) x)
        (hg.contDiff.differentiable (by simp) x)
    rw [he]
    exact ihf.add ihg
  | @mul f g hf hg ihf ihg =>
    have he : (fun x => fderiv ℝ (fun y => f y * g y) x) =
        fun x => f x • fderiv ℝ g x + g x • fderiv ℝ f x := by
      funext x
      exact fderiv_fun_mul (hf.contDiff.differentiable (by simp) x)
        (hg.contDiff.differentiable (by simp) x)
    rw [he]
    exact (hf.hasGrowth.smul ihg).add (hg.hasGrowth.smul ihf)

lemma IsPolynomial.memLp {μ : Measure E} [IsFiniteMeasure μ]
    (hμ : Appell.HasMoments μ) {f : E → ℝ} (hf : IsPolynomial f) : MemLp f 2 μ :=
  hf.hasGrowth.memLp hf.contDiff.continuous.aestronglyMeasurable hμ

lemma IsPolynomial.integrable_sq_fderiv {μ : Measure E} [IsFiniteMeasure μ]
    (hμ : Appell.HasMoments μ) {f : E → ℝ} (hf : IsPolynomial f) :
    Integrable (fun x => ‖fderiv ℝ f x‖ ^ 2) μ :=
  (hf.fderiv_hasGrowth.norm.pow 2).integrable
    ((hf.contDiff.continuous_fderiv (by simp)).norm.pow 2).aestronglyMeasurable hμ

/-- At zero Poincaré constant, every positive-degree Appell contraction vanishes
almost surely. This is an actual measure statement, not division by `β`. -/
theorem Appell.ae_tensorPolynomial_eq_zero (μ : Measure E) [IsProbabilityMeasure μ]
    (hμ : Appell.HasMoments μ) (hP : HasPolynomialPoincare μ 0)
    {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]
    [Fintype κ] [DecidableEq κ] (b : OrthonormalBasis κ ℝ E)
    (T : (ι → κ) → ℝ) : ∀ᵐ x ∂μ, tensorPolynomial μ b T x = 0 := by
  have h := tensorPolynomial_L2 μ hμ (le_refl 0) hP b T
  have hc : Fintype.card ι ≠ 0 := Fintype.card_ne_zero
  simp only [zero_pow hc, zero_mul] at h
  have he : (∫ x, (tensorPolynomial μ b T x)^2 ∂μ) = 0 :=
    le_antisymm h (integral_nonneg fun _ => sq_nonneg _)
  have ha := (integral_eq_zero_iff_of_nonneg (fun _ => sq_nonneg _)
    (tensorPolynomial_memLp μ hμ b T).integrable_sq).mp he
  filter_upwards [ha] with x hx
  exact sq_eq_zero_iff.mp hx

end
