namespace AcceleratedLogConcave.Conditional
noncomputable section
open MeasureTheory ProbabilityTheory Filter Set
open scoped Topology RealInnerProductSpace ENNReal NNReal
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]

/-- The actual multivariate MGF is finite on some neighborhood of zero.
No all-parameter exponential-moment hypothesis is imposed. -/
def HasLocalMGF (μ : Measure E) : Prop :=
  ∀ᶠ θ : E in 𝓝 0, Integrable (fun x => Real.exp (inner ℝ θ x)) μ

omit [BorelSpace E] in
lemma HasLocalMGF.directional {μ : Measure E} (hμ : HasLocalMGF μ) (v : E) :
    0 ∈ interior (integrableExpSet (fun x => inner ℝ v x) μ) := by
  have hc : Continuous (fun t : ℝ => t • v) := by fun_prop
  have ht : Tendsto (fun t : ℝ => t • v) (𝓝 0) (𝓝 (0 : E)) := by
    convert hc.tendsto (0 : ℝ) using 1
    simp
  apply mem_interior_iff_mem_nhds.mpr
  change ∀ᶠ t : ℝ in 𝓝 0, Integrable (fun x => Real.exp (t * inner ℝ v x)) μ
  simpa only [real_inner_smul_left] using ht.eventually hμ

omit [BorelSpace E] in
/-- Local MGF finiteness supplies every finite-dimensional polynomial norm
moment through the scalar coordinate moment theorem. -/
theorem HasLocalMGF.hasMoments {μ : Measure E} [IsFiniteMeasure μ]
    (hμ : HasLocalMGF μ) {κ : Type*} [Fintype κ]
    (b : OrthonormalBasis κ ℝ E) : Appell.HasMoments μ := by
  intro n
  have hi (i : κ) : MemLp (fun x => inner ℝ (b i) x) (n : ℝ≥0∞) μ := by
    simpa using memLp_of_mem_interior_integrableExpSet (hμ.directional (b i)) (n : ℝ≥0)
  have hs : MemLp (fun x : E => ∑ i, inner ℝ (b i) x • b i) (n : ℝ≥0∞) μ := by
    apply memLp_finsetSum
    intro i _
    exact ((ContinuousLinearMap.id ℝ ℝ).smulRight (b i)).comp_memLp' (hi i)
  have hid : MemLp (fun x : E => x) (n : ℝ≥0∞) μ := by
    simpa only [b.sum_repr'] using hs
  exact hid.integrable_norm_pow'

end
end AcceleratedLogConcave.Conditional

namespace AcceleratedLogConcave.Conditional.Appell
noncomputable section
open MeasureTheory
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]
variable {ι ϑ κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype ϑ] [DecidableEq ϑ]
  [Fintype κ] [DecidableEq κ]

/-- The mixed Appell coefficient has the genuine rectangular Hilbert operator
bound, with no loss depending on dimension or on the shape of the split. -/
theorem crossMoment_operator_norm_le (μ : Measure E) [IsProbabilityMeasure μ]
    (hμ : HasMoments μ) {β : ℝ} (hβ : 0 ≤ β) (hP : HasPolynomialPoincare μ β)
    (b : OrthonormalBasis κ ℝ E) :
    ‖Tensor.matrixCLMEquiv (crossMoment μ b (ι := ι) (ϑ := ϑ))‖ ≤
      (Real.sqrt β) ^ (Fintype.card ι + Fintype.card ϑ) *
        ((Fintype.card ι).factorial : ℝ) * ((Fintype.card ϑ).factorial : ℝ) := by
  apply Tensor.matrixCLM_norm_le_of_bilinear_sq _ _ (by positivity)
  intro T U
  have he : ((Real.sqrt β) ^ (Fintype.card ι + Fintype.card ϑ) *
        ((Fintype.card ι).factorial : ℝ) * ((Fintype.card ϑ).factorial : ℝ)) ^ 2 =
      (β ^ Fintype.card ι * ((Fintype.card ι).factorial : ℝ)^2) *
        (β ^ Fintype.card ϑ * ((Fintype.card ϑ).factorial : ℝ)^2) := by
    rw [mul_pow, mul_pow, pow_right_comm, Real.sq_sqrt hβ, pow_add]
    ring
  rw [he]
  exact crossMoment_sq_bound μ hμ hβ hP b T U

end
end AcceleratedLogConcave.Conditional.Appell

open Finset

namespace AcceleratedLogConcave.Conditional.Majorant

lemma shifted_vandermonde (j k : ℕ) (hk : 0 < k) :
    (∑ m ∈ Icc 1 (min j k), j.choose m * (k - 1).choose (m - 1)) =
      (j + k - 1).choose k := by
  have hsub : Icc 1 (min j k) ⊆ range (k + 1) := by
    intro m hm
    simp only [mem_Icc, mem_range] at *
    omega
  calc
    (∑ m ∈ Icc 1 (min j k), j.choose m * (k - 1).choose (m - 1)) =
        ∑ m ∈ Icc 1 (min j k), j.choose m * (k - 1).choose (k - m) := by
      apply sum_congr rfl
      intro m hm
      have hm' := mem_Icc.mp hm
      have hmk : m ≤ k := le_trans hm'.2 (min_le_right _ _)
      have heq : k - 1 - (m - 1) = k - m := by omega
      rw [← heq, Nat.choose_symm (by omega : m - 1 ≤ k - 1)]
    _ = ∑ m ∈ range (k + 1), j.choose m * (k - 1).choose (k - m) := by
      apply sum_subset hsub
      intro m hm hn
      have hmk : m ≤ k := by simpa using mem_range.mp hm
      by_cases hm0 : m = 0
      · subst m
        simp [Nat.choose_eq_zero_of_lt (by omega : k - 1 < k)]
      · have hjm : j < m := by
          simp only [mem_Icc, not_and_or, not_le] at hn
          omega
        simp [Nat.choose_eq_zero_of_lt hjm]
    _ = (j + k - 1).choose k := by
      rw [show j + k - 1 = j + (k - 1) by omega,
        Nat.add_choose_eq, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]

variable {𝕂 : Type*} [Field 𝕂] [CharZero 𝕂]

lemma reciprocal_mul_choose (j m : ℕ) (hj : 0 < j) (hm : 0 < m) :
    (1 / (m : 𝕂)) * ((j - 1).choose (m - 1) : 𝕂) =
      (j.choose m : 𝕂) / (j : 𝕂) := by
  have hj0 : (j : 𝕂) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hj)
  have hm0 : (m : 𝕂) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hm)
  have hn := Nat.add_one_mul_choose_eq (j - 1) (m - 1)
  rw [show j - 1 + 1 = j by omega, show m - 1 + 1 = m by omega] at hn
  have hc : (j : 𝕂) * ((j - 1).choose (m - 1) : 𝕂) =
      (j.choose m : 𝕂) * (m : 𝕂) := by exact_mod_cast hn
  calc
    (1 / (m : 𝕂)) * ((j - 1).choose (m - 1) : 𝕂) =
        ((j - 1).choose (m - 1) : 𝕂) / (m : 𝕂) := by ring
    _ = (j.choose m : 𝕂) / (j : 𝕂) := by
      apply (div_eq_div_iff hm0 hj0).2
      simpa [mul_comm] using hc

lemma choose_div_eq_factorial (j k : ℕ) (hj : 0 < j) :
    ((j + k - 1).choose k : 𝕂) / (j : 𝕂) =
      ((j + k - 1).factorial : 𝕂) / ((j.factorial : 𝕂) * (k.factorial : 𝕂)) := by
  have hj0 : (j : 𝕂) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hj)
  have hjf : (j.factorial : 𝕂) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero j
  have hkf : (k.factorial : 𝕂) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero k
  have hn := Nat.choose_mul_factorial_mul_factorial (by omega : k ≤ j + k - 1)
  rw [show j + k - 1 - k = j - 1 by omega] at hn
  have hc : ((j + k - 1).choose k : 𝕂) * (k.factorial : 𝕂) *
      ((j - 1).factorial : 𝕂) = ((j + k - 1).factorial : 𝕂) := by exact_mod_cast hn
  have hjfac : (j.factorial : 𝕂) = (j : 𝕂) * ((j - 1).factorial : 𝕂) := by
    have ht := Nat.factorial_succ (j - 1)
    rw [show j - 1 + 1 = j by omega] at ht
    exact_mod_cast ht
  apply (div_eq_div_iff hj0 (mul_ne_zero hjf hkf)).2
  rw [hjfac]
  linear_combination (j : 𝕂) * hc

/-- Exact sharp bivariate log-majorant coefficient, purely finite algebra. -/
theorem log_majorant_coefficient (j k : ℕ) (hj : 0 < j) (hk : 0 < k) :
    (∑ m ∈ Icc 1 (min j k),
      (1 / (m : 𝕂)) * ((j - 1).choose (m - 1) : 𝕂) *
        ((k - 1).choose (m - 1) : 𝕂)) =
      ((j + k - 1).factorial : 𝕂) / ((j.factorial : 𝕂) * (k.factorial : 𝕂)) := by
  calc
    (∑ m ∈ Icc 1 (min j k),
        (1 / (m : 𝕂)) * ((j - 1).choose (m - 1) : 𝕂) *
          ((k - 1).choose (m - 1) : 𝕂)) =
        ∑ m ∈ Icc 1 (min j k),
          ((j.choose m : 𝕂) / (j : 𝕂)) * ((k - 1).choose (m - 1) : 𝕂) := by
      apply sum_congr rfl
      intro m hm
      rw [reciprocal_mul_choose j m hj (by have := (mem_Icc.mp hm).1; omega)]
    _ = (∑ m ∈ Icc 1 (min j k),
          (j.choose m * (k - 1).choose (m - 1) : ℕ)) / (j : 𝕂) := by
      simp only [Nat.cast_sum, Nat.cast_mul, div_mul_eq_mul_div, sum_div]
    _ = ((j + k - 1).choose k : 𝕂) / (j : 𝕂) := by
      rw [shifted_vandermonde j k hk]
    _ = ((j + k - 1).factorial : 𝕂) / ((j.factorial : 𝕂) * (k.factorial : 𝕂)) :=
      choose_div_eq_factorial j k hj

end AcceleratedLogConcave.Conditional.Majorant


open Finset
namespace AcceleratedLogConcave.Conditional.FiberCount

def positiveFactorial (n : ℕ) : ℕ := if n = 0 then 0 else n.factorial

@[simp] lemma positiveFactorial_zero : positiveFactorial 0 = 0 := by simp [positiveFactorial]
lemma positiveFactorial_of_pos {n : ℕ} (hn : 0 < n) : positiveFactorial n = n.factorial := by
  simp [positiveFactorial, hn.ne']
lemma positiveFactorial_succ (n : ℕ) :
    positiveFactorial (n + 1) = (n + 1) * positiveFactorial n + if n = 0 then 1 else 0 := by
  cases n <;> simp [positiveFactorial, Nat.factorial_succ]

variable {R N : Type*} [Fintype R] [Fintype N] [DecidableEq N]
def fiberCount (p : R → N) (i : N) : ℕ := ∑ r, if p r = i then 1 else 0
def weight (p : R → N) : ℕ := ∏ i, positiveFactorial (fiberCount p i)
def weightedCount (R N : Type*) [Fintype R] [Fintype N] [DecidableEq R] [DecidableEq N] : ℕ :=
  ∑ p : R → N, weight p

lemma sum_fiberCount (p : R → N) : ∑ i, fiberCount p i = Fintype.card R := by
  unfold fiberCount
  rw [sum_comm]
  simp

omit [Fintype N] in
lemma fiberCount_option (p : R → N) (i k : N) :
    fiberCount (fun x : Option R => x.elim i p) k = fiberCount p k + if i = k then 1 else 0 := by
  simp only [fiberCount, Fintype.sum_option, Option.elim_none, Option.elim_some]
  exact Nat.add_comm _ _

lemma weight_option (p : R → N) (i : N) :
    weight (fun x : Option R => x.elim i p) =
      (fiberCount p i + 1) * weight p +
        if fiberCount p i = 0 then ∏ k ∈ (univ : Finset N).erase i, positiveFactorial (fiberCount p k) else 0 := by
  classical
  have hi : i ∈ (univ : Finset N) := mem_univ i
  rw [weight, ← mul_prod_erase _ _ hi]
  simp only [fiberCount_option, ite_true]
  have he : (∏ k ∈ (univ : Finset N).erase i,
      positiveFactorial (fiberCount p k + if i = k then 1 else 0)) =
      ∏ k ∈ (univ : Finset N).erase i, positiveFactorial (fiberCount p k) := by
    apply prod_congr rfl
    intro k hk
    simp [(mem_erase.mp hk).1.symm]
  rw [he, positiveFactorial_succ, add_mul]
  have hw : weight p = positiveFactorial (fiberCount p i) *
      ∏ k ∈ (univ : Finset N).erase i, positiveFactorial (fiberCount p k) := by
    exact (mul_prod_erase _ _ hi).symm
  rw [hw, mul_assoc]
  split_ifs <;> simp

lemma sum_weight_option (p : R → N) :
    (∑ i, weight (fun x : Option R => x.elim i p)) =
      (Fintype.card R + Fintype.card N) * weight p +
        ∑ i, if fiberCount p i = 0 then
          ∏ k ∈ (univ : Finset N).erase i, positiveFactorial (fiberCount p k) else 0 := by
  simp only [weight_option, sum_add_distrib, ← sum_mul, sum_fiberCount,
    sum_const, card_univ, smul_eq_mul, mul_one]


omit [Fintype N] in
lemma fiberCount_eq_zero (p : R → N) (i : N) :
    fiberCount p i = 0 ↔ ∀ r, p r ≠ i := by
  classical
  simp [fiberCount]

variable [DecidableEq R]

lemma sum_avoid (i : N) :
    (∑ p : R → N, if fiberCount p i = 0 then
      ∏ k ∈ (univ : Finset N).erase i, positiveFactorial (fiberCount p k) else 0) =
      weightedCount R {k : N // k ≠ i} := by
  classical
  let e : {p : R → N // ∀ r, p r ≠ i} ≃ (R → {k : N // k ≠ i}) :=
    Equiv.subtypePiEquivPi (p := fun (_ : R) (k : N) => k ≠ i)
  simp_rw [fiberCount_eq_zero]
  rw [← Finset.sum_filter]
  rw [Finset.sum_subtype _ (p := fun p : R → N => ∀ r, p r ≠ i) (fun p => by simp)]
  rw [← e.symm.sum_comp]
  unfold weightedCount
  apply Finset.sum_congr rfl
  intro q _
  change (∏ k ∈ (univ : Finset N).erase i,
    positiveFactorial (fiberCount (fun r => (q r).val) k)) = weight q
  rw [Finset.prod_subtype _ (p := fun k : N => k ≠ i) (fun k => by simp)]
  unfold weight
  apply Finset.prod_congr rfl
  intro k _
  congr 1
  simp only [fiberCount, Subtype.ext_iff]

lemma weightedCount_option :
    weightedCount (Option R) N =
      (Fintype.card R + Fintype.card N) * weightedCount R N +
        ∑ i : N, weightedCount R {k : N // k ≠ i} := by
  classical
  unfold weightedCount
  rw [← (Equiv.piOptionEquivProd (α := R) (β := fun _ : Option R => N)).symm.sum_comp
    (fun p : Option R → N => weight p)]
  rw [Fintype.sum_prod_type, sum_comm]
  have he (p : R → N) (i : N) :
      (Equiv.piOptionEquivProd (α := R) (β := fun _ : Option R => N)).symm (i, p) =
        fun x : Option R => x.elim i p := by
    funext x
    cases x <;> rfl
  simp_rw [he]
  simp_rw [sum_weight_option]
  rw [sum_add_distrib, ← mul_sum]
  congr 1
  rw [sum_comm]
  apply sum_congr rfl
  intro i _
  exact sum_avoid i


lemma weightedCount_singleton (hN : Fintype.card N = 1) :
    weightedCount R N = positiveFactorial (Fintype.card R) := by
  classical
  have hne : Nonempty N := Fintype.card_pos_iff.mp (by omega)
  have hsub : Subsingleton N := Fintype.card_le_one_iff_subsingleton.mp (by omega)
  let : Unique N := { default := Classical.choice hne, uniq := fun _ => Subsingleton.elim _ _ }
  simp [weightedCount, weight, fiberCount]

omit [DecidableEq R] in
lemma weight_eq_zero_of_card_lt (h : Fintype.card R < Fintype.card N) (p : R → N) :
    weight p = 0 := by
  classical
  have hns : ¬ Function.Surjective p := fun hs =>
    (not_le_of_gt h) (Fintype.card_le_of_surjective p hs)
  obtain ⟨i, hi⟩ := not_forall.mp hns
  have hzero : fiberCount p i = 0 := (fiberCount_eq_zero p i).mpr (by simpa using hi)
  exact Finset.prod_eq_zero (mem_univ i) (by rw [hzero, positiveFactorial_zero])

lemma weightedCount_eq_zero_of_card_lt (h : Fintype.card R < Fintype.card N) :
    weightedCount R N = 0 := by
  unfold weightedCount
  apply sum_eq_zero
  intro p _
  exact weight_eq_zero_of_card_lt h p

variable {S : Type*} [Fintype S] [DecidableEq S]
omit [DecidableEq R] [DecidableEq S] in
lemma weight_comp (e : S ≃ R) (p : R → N) : weight (p ∘ e) = weight p := by
  unfold weight
  apply prod_congr rfl
  intro i _
  congr 1
  exact e.sum_comp (fun r => if p r = i then (1 : ℕ) else 0)

lemma weightedCount_congr (e : S ≃ R) : weightedCount S N = weightedCount R N := by
  let f : (S → N) ≃ (R → N) := Equiv.arrowCongr e (Equiv.refl N)
  have hh := f.sum_comp (fun p : R → N => weight p)
  have he (p : S → N) : weight (f p) = weight p := weight_comp e.symm p
  simp_rw [he] at hh
  exact hh

lemma weightedChoose_recurrence (j m : ℕ) :
    (j + m + 3) * j.choose (m + 1) + (m + 2) * j.choose m =
      (j + 2) * (j + 1).choose (m + 1) := by
  have h := Nat.add_one_mul_choose_eq j m
  rw [Nat.choose_succ_succ] at h ⊢
  nlinarith

end AcceleratedLogConcave.Conditional.FiberCount

namespace AcceleratedLogConcave.Conditional.FiberCount
universe u v

theorem weightedCount_formula (j m : ℕ) :
    ∀ (R : Type u) (N : Type v) [Fintype R] [Fintype N] [DecidableEq R] [DecidableEq N],
      Fintype.card R = j + 1 → Fintype.card N = m + 1 →
      weightedCount R N = (j + 1).factorial * j.choose m := by
  induction j generalizing m with
  | zero =>
    intro R N _ _ _ _ hR hN
    cases m with
    | zero =>
      rw [weightedCount_singleton hN, hR]
      norm_num [positiveFactorial]
    | succ m =>
      rw [weightedCount_eq_zero_of_card_lt (by omega)]
      simp
  | succ j ih =>
    intro R N _ _ _ _ hR hN
    cases m with
    | zero =>
      rw [weightedCount_singleton hN, hR]
      simp [positiveFactorial]
    | succ m =>
      classical
      have hn : Nonempty R := Fintype.card_pos_iff.mp (by omega)
      let r : R := Classical.choice hn
      let S := {s : R // s ≠ r}
      have hS : Fintype.card S = j + 1 := by
        simp only [S, Fintype.card_subtype_compl, Fintype.card_subtype_eq, hR]
        omega
      have hN' (i : N) : Fintype.card {k : N // k ≠ i} = m + 1 := by
        rw [Fintype.card_subtype_compl, Fintype.card_subtype_eq, hN]
        omega
      rw [← weightedCount_congr (N := N) (Equiv.optionSubtypeNe r), weightedCount_option]
      change (Fintype.card S + Fintype.card N) * weightedCount S N +
        ∑ i : N, weightedCount S {k : N // k ≠ i} = _
      rw [ih (m + 1) S N hS hN]
      simp_rw [ih m S _ hS (hN' _)]
      simp only [hS, hN, sum_const, card_univ, smul_eq_mul]
      have hc := congrArg (fun n : ℕ => (j + 1).factorial * n)
        (weightedChoose_recurrence j m)
      convert hc using 1 <;> simp only [Nat.factorial_succ] <;> ring

end AcceleratedLogConcave.Conditional.FiberCount


namespace AcceleratedLogConcave.Conditional.FiberEnergy
open scoped BigOperators
variable {I J K L : Type*} [Fintype I] [Fintype J] [Fintype K] [Fintype L]
abbrev Bound (A : I → J → ℝ) (C : ℝ) : Prop := Tensor.EnergyBound A C
lemma energy_nonneg (v : I → ℝ) : 0 ≤ ∑ i, (v i)^2 :=
  Finset.sum_nonneg (fun _ _ => sq_nonneg _)
lemma Bound.kronecker {A : I → J → ℝ} {B : K → L → ℝ} {C D : ℝ}
    (hA : Bound A C) (hB : Bound B D) (hC : 0 ≤ C) :
    Bound (fun (i : I × K) (j : J × L) => A i.1 j.1 * B i.2 j.2) (C*D) :=
  Tensor.EnergyBound.kronecker hA hB hC
lemma Bound.reindex {A : I → J → ℝ} {C : ℝ} (h : Bound A C)
    (e : K ≃ I) (f : L ≃ J) : Bound (fun k l => A (e k) (f l)) C := by
  intro v
  have hh := h (v ∘ f.symm)
  rw [← e.sum_comp] at hh
  simp_rw [← f.sum_comp] at hh
  simpa only [Function.comp_def,Equiv.symm_apply_apply] using hh

lemma prod_split {N : Type*} [Fintype N] [DecidableEq N] (i : N) (f : N → ℝ) :
    (∏ j, f j) = f i * ∏ j : {j : N // j ≠ i}, f j := by
  rw [← Finset.mul_prod_erase Finset.univ f (Finset.mem_univ i)]
  congr 1
  exact Finset.prod_subtype _ (by simp) _

universe u v w
lemma bound_pi_aux (n : ℕ) : ∀ (N : Type u) [Fintype N] [DecidableEq N],
    Fintype.card N = n → ∀ (A : N → Type v) (B : N → Type w)
    [∀ i, Fintype (A i)] [∀ i, Fintype (B i)]
    (M : ∀ i, A i → B i → ℝ) (C : N → ℝ),
    (∀ i, 0 ≤ C i) → (∀ i, Bound (M i) (C i)) →
    Bound (fun (a : ∀ i, A i) (b : ∀ i, B i) => ∏ i, M i (a i) (b i)) (∏ i, C i) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro N _ _ hc A B _ _ M C hC hM
    by_cases hn : n=0
    · have : IsEmpty N := Fintype.card_eq_zero_iff.mp (hc.trans hn)
      let a : ∀ i, A i := fun i => isEmptyElim i
      let b : ∀ i, B i := fun i => isEmptyElim i
      let : Unique (∀ i, A i) := ⟨⟨a⟩,fun _ => funext (fun i => isEmptyElim i)⟩
      let : Unique (∀ i, B i) := ⟨⟨b⟩,fun _ => funext (fun i => isEmptyElim i)⟩
      intro _
      simp
    · have hp : 0<n := Nat.pos_of_ne_zero hn
      have : Nonempty N := Fintype.card_pos_iff.mp (hc ▸ hp)
      let i : N := Classical.choice this
      have hcard : Fintype.card {j : N // j ≠ i} = n-1 := by
        rw [Fintype.card_subtype_compl,Fintype.card_subtype_eq,hc]
      have hr := ih (n-1) (Nat.sub_lt hp (by norm_num)) {j : N // j ≠ i} hcard
        (fun j => A j) (fun j => B j) (fun j => M j) (fun j => C j)
        (fun j => hC j) (fun j => hM j)
      have hh := ((hM i).kronecker hr (hC i)).reindex
        (Equiv.piSplitAt i A) (Equiv.piSplitAt i B)
      rw [← prod_split] at hh
      convert hh using 1
      funext a b
      exact prod_split i (fun j => M j (a j) (b j))

lemma Bound.pi {N : Type u} [Fintype N] [DecidableEq N]
    {A : N → Type v} {B : N → Type w} [∀ i, Fintype (A i)] [∀ i, Fintype (B i)]
    {M : ∀ i, A i → B i → ℝ} {C : N → ℝ}
    (hC : ∀ i, 0 ≤ C i) (hM : ∀ i, Bound (M i) (C i)) :
    Bound (fun (a : ∀ i, A i) (b : ∀ i, B i) => ∏ i, M i (a i) (b i)) (∏ i, C i) :=
  bound_pi_aux _ N rfl A B M C hC hM

lemma Bound.fibers {N R S : Type*} [Fintype N] [DecidableEq N]
    [Fintype R] [Fintype S] [DecidableEq R] [DecidableEq S]
    (p : R → N) (q : S → N)
    {M : ∀ i, ({r : R // p r = i} → I) → ({s : S // q s = i} → J) → ℝ}
    {C : N → ℝ} (hC : ∀ i, 0 ≤ C i) (hM : ∀ i, Bound (M i) (C i)) :
    Bound (fun (a : R → I) (b : S → J) =>
      ∏ i, M i (fun r => a r) (fun s => b s)) (∏ i, C i) := by
  have hh := (Bound.pi hC hM).reindex
    (Equiv.piCongrFiberwise (γ₁ := fun _ => I) (f := p) (fun _ => Equiv.refl _))
    (Equiv.piCongrFiberwise (γ₁ := fun _ => J) (f := q) (fun _ => Equiv.refl _))
  exact hh

lemma Bound.mono {A : I → J → ℝ} {C D : ℝ} (h : Bound A C) (hCD : C ≤ D) :
    Bound A D := fun v => (h v).trans
      (mul_le_mul_of_nonneg_right hCD (energy_nonneg v))


end AcceleratedLogConcave.Conditional.FiberEnergy

namespace AcceleratedLogConcave.Conditional.FiberCount
variable {R N : Type*} [Fintype R] [DecidableEq N]
lemma fiberCount_eq_card (p : R → N) (i : N) :
    fiberCount p i = Fintype.card {r : R // p r = i} := by
  classical
  simp [fiberCount, Fintype.card_subtype]
end AcceleratedLogConcave.Conditional.FiberCount

namespace AcceleratedLogConcave.Conditional.Appell
noncomputable section
open MeasureTheory FiberCount
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]
variable {ι ϑ κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype ϑ] [DecidableEq ϑ]
  [Fintype κ] [DecidableEq κ]

/-- Pure coefficients of the reduced cross-MGF vanish. -/
def reducedCrossMoment (μ : Measure E) (b : OrthonormalBasis κ ℝ E)
    (a : ι → κ) (c : ϑ → κ) : ℝ :=
  if Fintype.card ι = 0 ∨ Fintype.card ϑ = 0 then 0 else crossMoment μ b a c

lemma reducedCrossMoment_energy (μ : Measure E) [IsProbabilityMeasure μ]
    (hμ : HasMoments μ) {β : ℝ} (hβ : 0 ≤ β) (hP : HasPolynomialPoincare μ β)
    (b : OrthonormalBasis κ ℝ E) :
    FiberEnergy.Bound (reducedCrossMoment μ b (ι := ι) (ϑ := ϑ))
      (((Real.sqrt β) ^ (Fintype.card ι + Fintype.card ϑ) *
        (positiveFactorial (Fintype.card ι) : ℝ) *
        (positiveFactorial (Fintype.card ϑ) : ℝ)) ^ 2) := by
  unfold reducedCrossMoment
  split_ifs with hzero
  · rcases hzero with hzero | hzero <;>
      simp [hzero, positiveFactorial, FiberEnergy.Bound, Tensor.EnergyBound]
  · have hI : 0 < Fintype.card ι := Nat.pos_of_ne_zero (fun h => hzero (Or.inl h))
    have hJ : 0 < Fintype.card ϑ := Nat.pos_of_ne_zero (fun h => hzero (Or.inr h))
    rw [positiveFactorial_of_pos hI, positiveFactorial_of_pos hJ]
    exact FiberEnergy.Bound.mono (Tensor.energyBound_opNorm _)
      (pow_le_pow_left₀ (norm_nonneg _) (crossMoment_operator_norm_le μ hμ hβ hP b) 2)

def crossBlockProduct {N : Type*} [Fintype N] [DecidableEq N]
    (μ : Measure E) (b : OrthonormalBasis κ ℝ E) (p : ι → N) (q : ϑ → N)
    (a : ι → κ) (c : ϑ → κ) : ℝ :=
  ∏ i, reducedCrossMoment μ b (fun j : {j : ι // p j = i} => a j)
    (fun j : {j : ϑ // q j = i} => c j)

/-- Exact block-product norm with nonempty fiber factorials; empty fibers
contribute zero, which is essential to the sharp logarithm coefficient count. -/
theorem crossBlockProduct_operator_norm_le {N : Type*} [Fintype N] [DecidableEq N]
    (μ : Measure E) [IsProbabilityMeasure μ] (hμ : HasMoments μ)
    {β : ℝ} (hβ : 0 ≤ β) (hP : HasPolynomialPoincare μ β)
    (b : OrthonormalBasis κ ℝ E) (p : ι → N) (q : ϑ → N) :
    ‖Tensor.matrixCLMEquiv (crossBlockProduct μ b p q)‖ ≤
      (Real.sqrt β) ^ (Fintype.card ι + Fintype.card ϑ) *
        (weight p : ℝ) * (weight q : ℝ) := by
  let C (i : N) : ℝ := (Real.sqrt β) ^
      (Fintype.card {j : ι // p j = i} + Fintype.card {j : ϑ // q j = i}) *
      (positiveFactorial (Fintype.card {j : ι // p j = i}) : ℝ) *
      (positiveFactorial (Fintype.card {j : ϑ // q j = i}) : ℝ)
  have he : (∏ i, (C i)^2) =
      ((Real.sqrt β) ^ (Fintype.card ι + Fintype.card ϑ) *
        (weight p : ℝ) * (weight q : ℝ))^2 := by
    rw [Finset.prod_pow]
    congr 1
    simp only [C, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum,
      Finset.sum_add_distrib, ← fiberCount_eq_card, sum_fiberCount,
      weight, Nat.cast_prod]
  apply Tensor.opNorm_le_of_energyBound _ _ (by positivity)
  rw [← he]
  exact FiberEnergy.Bound.fibers p q (fun _ => sq_nonneg _)
    (fun _ => reducedCrossMoment_energy μ hμ hβ hP b)

end
end AcceleratedLogConcave.Conditional.Appell

namespace AcceleratedLogConcave.Conditional.FiberCount
lemma weightedCount_formula_of_pos {R N : Type*} [Fintype R] [Fintype N]
    [DecidableEq R] [DecidableEq N] (hR : 0 < Fintype.card R) (hN : 0 < Fintype.card N) :
    weightedCount R N = (Fintype.card R).factorial *
      (Fintype.card R - 1).choose (Fintype.card N - 1) := by
  have h := weightedCount_formula (Fintype.card R - 1) (Fintype.card N - 1) R N
    (by omega) (by omega)
  simpa only [Nat.sub_add_cancel hR] using h
end AcceleratedLogConcave.Conditional.FiberCount

namespace AcceleratedLogConcave.Conditional.Appell
noncomputable section
open MeasureTheory FiberCount
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]
variable {ι ϑ κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype ϑ] [DecidableEq ϑ]
  [Fintype κ] [DecidableEq κ]

def crossBlockSum {N : Type*} [Fintype N] [DecidableEq N]
    (μ : Measure E) (b : OrthonormalBasis κ ℝ E) (a : ι → κ) (c : ϑ → κ) : ℝ :=
  ∑ p : ι → N, ∑ q : ϑ → N, crossBlockProduct μ b p q a c

set_option backward.isDefEq.respectTransparency false in
lemma crossBlockSum_operator_norm_le {N : Type*} [Fintype N] [DecidableEq N]
    (μ : Measure E) [IsProbabilityMeasure μ] (hμ : HasMoments μ)
    {β : ℝ} (hβ : 0 ≤ β) (hP : HasPolynomialPoincare μ β) (b : OrthonormalBasis κ ℝ E) :
    ‖Tensor.matrixCLMEquiv (crossBlockSum (N := N) μ b (ι := ι) (ϑ := ϑ))‖ ≤
      (Real.sqrt β) ^ (Fintype.card ι + Fintype.card ϑ) *
        (weightedCount ι N : ℝ) * (weightedCount ϑ N : ℝ) := by
  have he : (crossBlockSum (N := N) μ b (ι := ι) (ϑ := ϑ) :
      Matrix (ι → κ) (ϑ → κ) ℝ) =
      ∑ p : ι → N, ∑ q : ϑ → N,
        (crossBlockProduct μ b p q : Matrix (ι → κ) (ϑ → κ) ℝ) := by
    ext a c
    simp [crossBlockSum]
  rw [he]
  erw [map_sum]
  simp_rw [map_sum]
  calc
    _ ≤ ∑ p : ι → N, ∑ q : ϑ → N, ‖Tensor.matrixCLMEquiv (crossBlockProduct μ b p q)‖ :=
      (norm_sum_le _ _).trans (Finset.sum_le_sum fun p _ => norm_sum_le _ _)
    _ ≤ ∑ p : ι → N, ∑ q : ϑ → N,
        (Real.sqrt β) ^ (Fintype.card ι + Fintype.card ϑ) * (weight p : ℝ) * (weight q : ℝ) :=
      Finset.sum_le_sum fun p _ => Finset.sum_le_sum fun q _ =>
        crossBlockProduct_operator_norm_le μ hμ hβ hP b p q
    _ = _ := by
      simp only [weightedCount, Nat.cast_sum, ← Finset.mul_sum, ← Finset.sum_mul]

/-- The finite mixed coefficient of the formal logarithm of the normalized
cross-MGF. Its identification with actual local log-MGF derivatives is separate. -/
def mixedCumulant (μ : Measure E) (b : OrthonormalBasis κ ℝ E)
    (a : ι → κ) (c : ϑ → κ) : ℝ :=
  ∑ m ∈ Finset.Icc 1 (min (Fintype.card ι) (Fintype.card ϑ)),
    ((-1 : ℝ)^(m+1) / (m : ℝ)) * crossBlockSum (N := Fin m) μ b a c

lemma crossBlockSum_operator_norm_le_choose (μ : Measure E) [IsProbabilityMeasure μ]
    (hμ : HasMoments μ) {β : ℝ} (hβ : 0 ≤ β) (hP : HasPolynomialPoincare μ β)
    (b : OrthonormalBasis κ ℝ E) [Nonempty ι] [Nonempty ϑ] {m : ℕ} (hm : 0 < m) :
    ‖Tensor.matrixCLMEquiv (crossBlockSum (N := Fin m) μ b (ι := ι) (ϑ := ϑ))‖ ≤
      (Real.sqrt β) ^ (Fintype.card ι + Fintype.card ϑ) *
        ((Fintype.card ι).factorial : ℝ) * ((Fintype.card ϑ).factorial : ℝ) *
        ((Fintype.card ι - 1).choose (m - 1) : ℝ) *
        ((Fintype.card ϑ - 1).choose (m - 1) : ℝ) := by
  have h := crossBlockSum_operator_norm_le (N := Fin m) (ι := ι) (ϑ := ϑ) μ hμ hβ hP b
  rw [weightedCount_formula_of_pos (R := ι) (N := Fin m) Fintype.card_pos (by simpa using hm),
    weightedCount_formula_of_pos (R := ϑ) (N := Fin m) Fintype.card_pos (by simpa using hm)] at h
  simpa only [Fintype.card_fin, Nat.cast_mul, mul_assoc, mul_left_comm, mul_comm] using h

end
end AcceleratedLogConcave.Conditional.Appell

namespace AcceleratedLogConcave.Conditional.Appell
noncomputable section
open MeasureTheory FiberCount
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]
variable {ι ϑ κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype ϑ] [DecidableEq ϑ]
  [Fintype κ] [DecidableEq κ]

set_option backward.isDefEq.respectTransparency false in
/-- Sharp factorial bound for the actual finite Appell/log coefficient. The
constant comes from the proved weighted assignment count and Vandermonde sum. -/
theorem mixedCumulant_operator_norm_le (μ : Measure E) [IsProbabilityMeasure μ]
    (hμ : HasMoments μ) {β : ℝ} (hβ : 0 ≤ β) (hP : HasPolynomialPoincare μ β)
    (b : OrthonormalBasis κ ℝ E) [Nonempty ι] [Nonempty ϑ] :
    ‖Tensor.matrixCLMEquiv (mixedCumulant μ b (ι := ι) (ϑ := ϑ))‖ ≤
      ((Fintype.card ι + Fintype.card ϑ - 1).factorial : ℝ) *
        (Real.sqrt β) ^ (Fintype.card ι + Fintype.card ϑ) := by
  let S := Finset.Icc 1 (min (Fintype.card ι) (Fintype.card ϑ))
  let B : ℝ := (Real.sqrt β) ^ (Fintype.card ι + Fintype.card ϑ) *
    ((Fintype.card ι).factorial : ℝ) * ((Fintype.card ϑ).factorial : ℝ)
  have he : (mixedCumulant μ b (ι := ι) (ϑ := ϑ) : Matrix (ι → κ) (ϑ → κ) ℝ) =
      ∑ m ∈ S, ((-1 : ℝ)^(m+1) / (m : ℝ)) •
        (crossBlockSum (N := Fin m) μ b : Matrix (ι → κ) (ϑ → κ) ℝ) := by
    ext a c
    simp [mixedCumulant, S]
  rw [he]
  erw [map_sum]
  simp_rw [map_smul]
  calc
    _ ≤ ∑ m ∈ S, ‖((-1 : ℝ)^(m+1) / (m : ℝ)) •
        Tensor.matrixCLMEquiv (crossBlockSum (N := Fin m) μ b (ι := ι) (ϑ := ϑ))‖ :=
      norm_sum_le _ _
    _ = ∑ m ∈ S, (1 / (m : ℝ)) *
        ‖Tensor.matrixCLMEquiv (crossBlockSum (N := Fin m) μ b (ι := ι) (ϑ := ϑ))‖ := by
      apply Finset.sum_congr rfl
      intro m hm
      have hm' : (0 : ℝ) < m := by
        have hn : 0 < m := by have := (Finset.mem_Icc.mp hm).1; omega
        exact_mod_cast hn
      simp [norm_smul]
    _ ≤ ∑ m ∈ S, (1 / (m : ℝ)) *
        (B * ((Fintype.card ι - 1).choose (m - 1) : ℝ) *
          ((Fintype.card ϑ - 1).choose (m - 1) : ℝ)) := by
      apply Finset.sum_le_sum
      intro m hm
      exact mul_le_mul_of_nonneg_left
        (crossBlockSum_operator_norm_le_choose μ hμ hβ hP b
          (by have := (Finset.mem_Icc.mp hm).1; omega)) (by positivity)
    _ = B * (∑ m ∈ S, (1 / (m : ℝ)) *
        ((Fintype.card ι - 1).choose (m - 1) : ℝ) *
        ((Fintype.card ϑ - 1).choose (m - 1) : ℝ)) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro m _
      ring
    _ = B * (((Fintype.card ι + Fintype.card ϑ - 1).factorial : ℝ) /
        (((Fintype.card ι).factorial : ℝ) * ((Fintype.card ϑ).factorial : ℝ))) := by
      rw [Majorant.log_majorant_coefficient _ _ Fintype.card_pos Fintype.card_pos]
    _ = _ := by
      dsimp [B]
      have hi : ((Fintype.card ι).factorial : ℝ) ≠ 0 := by positivity
      have hk : ((Fintype.card ϑ).factorial : ℝ) ≠ 0 := by positivity
      field_simp

/-- The local-MGF/Poincaré hypotheses alone already yield the sharp finite
coefficient estimate. No all-parameter exponential moments are used. -/
theorem mixedCumulant_operator_norm_le_of_localMGF (μ : Measure E) [IsProbabilityMeasure μ]
    (hμ : HasLocalMGF μ) {β : ℝ} (hβ : 0 ≤ β) (hP : HasPolynomialPoincare μ β)
    (b : OrthonormalBasis κ ℝ E) [Nonempty ι] [Nonempty ϑ] :
    ‖Tensor.matrixCLMEquiv (mixedCumulant μ b (ι := ι) (ϑ := ϑ))‖ ≤
      ((Fintype.card ι + Fintype.card ϑ - 1).factorial : ℝ) *
        (Real.sqrt β) ^ (Fintype.card ι + Fintype.card ϑ) :=
  mixedCumulant_operator_norm_le μ (hμ.hasMoments b) hβ hP b

end
end AcceleratedLogConcave.Conditional.Appell

namespace AcceleratedLogConcave.Conditional
noncomputable section
open MeasureTheory ProbabilityTheory InnerProductSpace
open scoped ENNReal
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]

/-- The polynomial-test hypothesis is discharged by the actual Gibbs Poincaré
supplier. Polynomial square integrability follows from the actual norm moments. -/
theorem polynomialPoincare_of_gibbs (μ : Measure E) [IsProbabilityMeasure μ]
    (V : E → ℝ) (hV : ContDiff ℝ 2 V)
    (hI : Integrable (fun x => Real.exp (-V x)))
    (hμ : μ = volume.tilted (fun x => -V x)) (hMom : Appell.HasMoments μ)
    (m L : ℝ) (hm : 0 < m)
    (hlower : ∀ x a, m * ‖a‖ ^ 2 ≤ fderiv ℝ (fderiv ℝ V) x a a)
    (hupper : ∀ x a, fderiv ℝ (fderiv ℝ V) x a a ≤ L * ‖a‖ ^ 2) :
    HasPolynomialPoincare μ m⁻¹ := by
  intro f hf
  have hq : MemLp (gradient f) 2 μ := by
    apply (hf.fderiv_hasGrowth.norm.memLp
      (hf.contDiff.continuous_fderiv (by simp)).norm.aestronglyMeasurable hMom).of_le
      ((toDual ℝ E).symm.continuous.comp
        (hf.contDiff.continuous_fderiv (by simp))).aestronglyMeasurable
    filter_upwards [] with x
    simp only [Function.comp_apply, (toDual ℝ E).symm.norm_map, norm_norm, le_refl]
  have h := Gibbs.c1_variance_poincare μ V hV hI hμ m L hm hlower hupper f
    (hf.contDiff.of_le (by simp)) (hf.memLp hMom) hq
  have he (x : E) : ‖gradient f x‖ = ‖fderiv ℝ f x‖ :=
    (toDual ℝ E).symm.norm_map _
  simp_rw [he] at h
  rw [variance_eq_integral hf.contDiff.continuous.measurable.aemeasurable]
  exact (le_inv_mul_iff₀ hm).mpr h

/-- The normalized Gaussian posterior satisfies polynomial Poincaré with
constant `(m + t⁻¹)⁻¹`. No base normalizability and no supplied Poincaré axiom
are required; in particular, zero base curvature is allowed. -/
theorem posterior_polynomialPoincare {F : E → ℝ} {m L t : ℝ}
    (hF : ContDiff ℝ 2 F) (hm : 0 ≤ m) (ht : 0 < t) (y : E)
    (hlower : ∀ z v, m * ‖v‖ ^ 2 ≤ fderiv ℝ (fderiv ℝ F) z v v)
    (hupper : ∀ z v, fderiv ℝ (fderiv ℝ F) z v v ≤ L * ‖v‖ ^ 2) :
    HasPolynomialPoincare
      ((∫⁻ x : E, ENNReal.ofReal (Real.exp (-(F x + ‖x - y‖ ^ 2 / (2 * t)))))⁻¹ •
        volume.withDensity (fun x : E =>
          ENNReal.ofReal (Real.exp (-(F x + ‖x - y‖ ^ 2 / (2 * t))))))
      (m + t⁻¹)⁻¹ := by
  let V : E → ℝ := fun x => F x + ‖x - y‖ ^ 2 / (2 * t)
  let μ : Measure E := (∫⁻ x, ENNReal.ofReal (Real.exp (-V x)))⁻¹ •
    volume.withDensity (fun x => ENNReal.ofReal (Real.exp (-V x)))
  have : IsProbabilityMeasure μ :=
    Gibbs.normalized_posterior_isProbabilityMeasure_of_hessian_lower hF hm ht y hlower
  have hI : Integrable (fun x => Real.exp (-V x)) :=
    Gibbs.integrable_posterior_of_hessian_lower hF hm ht y hlower
  exact polynomialPoincare_of_gibbs μ V (Gibbs.contDiff_posterior_potential hF t y) hI
    (Gibbs.ennreal_smul_withDensity_eq_tilted volume V hI _ rfl)
    (fun n => Gibbs.integrable_norm_pow_posterior_of_hessian_lower hF hm ht y hlower n)
    (m + t⁻¹) (L + t⁻¹) (by positivity)
    (Gibbs.posterior_hessian_lower hF hlower t y)
    (Gibbs.posterior_hessian_upper hF hupper t y)

end
end AcceleratedLogConcave.Conditional

noncomputable section
open MeasureTheory Filter
open scoped Topology ENNReal NNReal RealInnerProductSpace
namespace AcceleratedLogConcave.Conditional
namespace JetCalculus
open scoped Topology

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
variable {ι : Type*}

def dir (v : E) (f : E → ℝ) : E → ℝ := fun x => fderiv ℝ f x v

def jet (v : ι → E) : List ι → (E → ℝ) → (E → ℝ)
  | [], f => f
  | i::l, f => dir (v i) (jet v l f)

lemma smooth_dir {f : E → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f) (v : E) :
    ContDiff ℝ (⊤ : ℕ∞) (dir v f) :=
  (hf.fderiv_right (by simp)).clm_apply contDiff_const

lemma smooth_jet {f : E → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f) (v : ι → E) (l : List ι) :
    ContDiff ℝ (⊤ : ℕ∞) (jet v l f) := by
  induction l with
  | nil => exact hf
  | cons i l ih => exact smooth_dir ih _

lemma dir_add {f g : E → ℝ} (hf : Differentiable ℝ f) (hg : Differentiable ℝ g) (v : E) :
    dir v (fun x => f x+g x) = fun x => dir v f x+dir v g x := by
  funext x
  change (fderiv ℝ (f+g) x) v = _
  rw [fderiv_add (hf x) (hg x)]
  rfl

lemma dir_mul {f g : E → ℝ} (hf : Differentiable ℝ f) (hg : Differentiable ℝ g) (v : E) :
    dir v (fun x => f x*g x) = fun x => dir v f x*g x+f x*dir v g x := by
  funext x
  change (fderiv ℝ (f*g) x) v = _
  rw [((hf x).hasFDerivAt.mul (hg x).hasFDerivAt).fderiv]
  simp only [add_apply,smul_apply,smul_eq_mul,dir]
  ring

lemma dir_sum {κ : Type*} (s : Finset κ) {f : κ → E → ℝ}
    (hf : ∀ i ∈ s, Differentiable ℝ (f i)) (v : E) :
    dir v (fun x => ∑ i ∈ s, f i x) = fun x => ∑ i ∈ s, dir v (f i) x := by
  funext x
  simp only [dir,(HasFDerivAt.fun_sum (fun i hi => (hf i hi x).hasFDerivAt)).fderiv,
    _root_.sum_apply]

lemma jet_add {f g : E → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (hg : ContDiff ℝ (⊤ : ℕ∞) g) (v : ι → E) (l : List ι) :
    jet v l (fun x => f x+g x) = fun x => jet v l f x+jet v l g x := by
  induction l with
  | nil => rfl
  | cons i l ih =>
    simp only [jet,ih]
    exact dir_add ((smooth_jet hf v l).differentiable (by simp))
      ((smooth_jet hg v l).differentiable (by simp)) _

lemma jet_sum {κ : Type*} (s : Finset κ) {f : κ → E → ℝ}
    (hf : ∀ i ∈ s, ContDiff ℝ (⊤ : ℕ∞) (f i)) (v : ι → E) (l : List ι) :
    jet v l (fun x => ∑ i ∈ s, f i x) = fun x => ∑ i ∈ s, jet v l (f i) x := by
  induction l with
  | nil => rfl
  | cons i l ih =>
    simp only [jet,ih]
    exact dir_sum s (fun j hj => (smooth_jet (hf j hj) v l).differentiable (by simp)) _

lemma jet_const (v : ι → E) (l : List ι) (c : ℝ) :
    jet v l (fun _ => c) = if l=[] then (fun _ => c) else (fun _ => 0) := by
  induction l with
  | nil => simp [jet]
  | cons i l ih =>
    simp only [jet,ih,List.cons_ne_nil,↓reduceIte]
    split_ifs <;> funext x <;> simp [dir]

section
variable [DecidableEq ι]
lemma filter_insert_of_not_mem (l : List ι) (i : ι) (s : Finset ι) (hi : i ∉ l) :
    l.filter (fun j => j ∈ insert i s) = l.filter (fun j => j ∈ s) := by
  apply List.filter_congr
  intro j hj
  have hji : j ≠ i := by intro h; subst j; exact hi hj
  simp [hji]

lemma filter_not_insert_of_not_mem (l : List ι) (i : ι) (s : Finset ι) (hi : i ∉ l) :
    l.filter (fun j => j ∉ insert i s) = l.filter (fun j => j ∉ s) := by
  apply List.filter_congr
  intro j hj
  have hji : j ≠ i := by intro h; subst j; exact hi hj
  simp [hji]

theorem jet_mul {f g : E → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (hg : ContDiff ℝ (⊤ : ℕ∞) g) (v : ι → E) (l : List ι) (hl : l.Nodup) :
    jet v l (fun x => f x*g x) = fun x =>
      ∑ s ∈ l.toFinset.powerset,
        jet v (l.filter (fun i => i ∈ s)) f x *
          jet v (l.filter (fun i => i ∉ s)) g x := by
  induction l with
  | nil => simp [jet]
  | cons i l ih =>
    have hi := (List.nodup_cons.mp hl).1
    have hl' := (List.nodup_cons.mp hl).2
    rw [jet,ih hl',dir_sum _ (fun s hs =>
      ((smooth_jet hf v _).mul (smooth_jet hg v _)).differentiable (by simp))]
    funext x
    simp only [List.toFinset_cons,Finset.sum_powerset_insert (by simpa using hi : i ∉ l.toFinset)]
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro s hs
    have his : i ∉ s := fun h => hi (List.mem_toFinset.mp ((Finset.mem_powerset.mp hs) h))
    rw [dir_mul ((smooth_jet hf v _).differentiable (by simp))
      ((smooth_jet hg v _).differentiable (by simp))]
    simp only [List.filter_cons,Finset.mem_insert_self,decide_true,↓reduceIte,
      his,decide_false,Bool.false_eq_true,not_false_eq_true,Finset.mem_insert_self,
      not_true_eq_false,filter_insert_of_not_mem l i s hi,filter_not_insert_of_not_mem l i s hi,jet]
    ring
end
