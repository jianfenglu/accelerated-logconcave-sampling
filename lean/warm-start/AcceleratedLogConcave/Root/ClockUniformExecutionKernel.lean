import AcceleratedLogConcave.Root.ClockUniformDraw
import AcceleratedLogConcave.Root.ClockJointClockExecutionKernel

/-! The retained root with a literal closed-unit-interval primitive draw for its
clock and an independent complete canonical syntax tape. -/
noncomputable section
set_option autoImplicit false
namespace AcceleratedLogConcave.Root.ClockUniformExecutionKernel
open MeasureTheory ProbabilityTheory Oracle Oracle.TapeLowering
open Oracle.CanonicalTapeMeasurability Oracle.CanonicalTapeLaw
open ClockJointClockExecutionKernel ClockUniformDraw

variable (P : SourceSchedule) (hR : P.R ≤ 1/2) (hc : 0 < P.csch)
    (hsmall : P.csch < 1/160) {d : ℕ} (ell : ℕ)

/-- The actual independent primitive draw and complete fresh syntax tape. -/
def drawLaw :
    let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
      tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell)
    Measure (UniformValue ×
      Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell)) :=
  let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
    tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)
  (ClockPublicSetupTapeLaw.standardLaws d).uniformDraw.prod
    (tapeLaw (ClockPublicSetupTapeLaw.standardLaws d)
      (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell))

private theorem drawLaw_probability :
    let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
      tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell)
    IsProbabilityMeasure (drawLaw P hR hc hsmall (d := d) ell) := by
  let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
    tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)
  have := (ClockPublicSetupTapeLaw.standardLaws d).uniform_probability
  have := tapeLaw_probability (ClockPublicSetupTapeLaw.standardLaws d)
    (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)
  unfold drawLaw
  infer_instance

/-- The literal root output after converting the primitive draw into its
physical clock value. -/
def output (G : Point d → Point d)
    (a : (Point d × Point d) × (UniformValue ×
      Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell))) : Point d :=
  ClockJointClockExecutionKernel.output P hR hc hsmall ell G
    ((clockOfUniform a.2.1, a.1), a.2.2)

theorem output_measurable (G : Point d → Point d) (hG : Measurable G) :
    let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
      tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell)
    Measurable (output P hR hc hsmall ell G) := by
  let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
    tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)
  exact (ClockJointClockExecutionKernel.output_measurable P hR hc hsmall ell G hG).comp
    (((measurable_clockOfUniform.comp measurable_snd.fst).prodMk measurable_fst).prodMk
      measurable_snd.snd)

/-- An input-indexed Markov kernel generated by the actual uniform primitive
and full fresh tape; the input position/momentum pair remains arbitrary. -/
def kernel (G : Point d → Point d) (hG : Measurable G) :
    Kernel (Point d × Point d) (Point d) :=
  let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
    tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)
  have := drawLaw_probability P hR hc hsmall (d := d) ell
  Channels.freshKernel (drawLaw P hR hc hsmall ell)
    (output P hR hc hsmall ell G)
    (output_measurable P hR hc hsmall ell G hG)

instance kernel_markov (G : Point d → Point d) (hG : Measurable G) :
    IsMarkovKernel (kernel P hR hc hsmall ell G hG) := by
  let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
    tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)
  have := drawLaw_probability P hR hc hsmall (d := d) ell
  unfold kernel
  infer_instance

/-- This retains the entire independently drawn clock and tape, not just the
clock marginal. -/
theorem drawLaw_map :
    let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
      tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell)
    (drawLaw P hR hc hsmall ell).map (fun a => (clockOfUniform a.1, a.2)) =
      Kinetic.sourceClockLaw.prod
        (tapeLaw (ClockPublicSetupTapeLaw.standardLaws d)
          (ClockRetainedFinalSplice.code P hR hc hsmall
            ClockRetainedTapeTransport.anchorClock ell)) := by
  let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
    tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)
  have := (ClockPublicSetupTapeLaw.standardLaws d).uniform_probability
  have := tapeLaw_probability (ClockPublicSetupTapeLaw.standardLaws d)
    (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)
  unfold drawLaw
  rw [← standardLaws_clock d]
  convert (Measure.map_prod_map
    (ClockPublicSetupTapeLaw.standardLaws d).uniformDraw
    (tapeLaw (ClockPublicSetupTapeLaw.standardLaws d)
      (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell))
    measurable_clockOfUniform measurable_id).symm using 1
  · congr 1
  · simp


/-- The fiber is a literal run under the joint primitive draw and fresh tape. -/
theorem kernel_apply (G : Point d → Point d) (hG : Measurable G)
    (x : Point d × Point d) :
    let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
      tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell)
    kernel P hR hc hsmall ell G hG x =
      (drawLaw P hR hc hsmall ell).map
        (fun z => output P hR hc hsmall ell G (x,z)) := by
  let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
    tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)
  unfold kernel
  rfl

/-- For every `SFinite` joint input law, the literal uniform-and-tape run has
exactly the law obtained by independent source-clock and full-tape draws.
The entering position and momentum remain in their original joint law. -/
theorem compProd_kernel (G : Point d → Point d) (hG : Measurable G)
    (ν : Measure (Point d × Point d)) [SFinite ν] :
    let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
      tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell)
    ν ⊗ₘ kernel P hR hc hsmall ell G hG =
      (ν.prod (Kinetic.sourceClockLaw.prod
        (tapeLaw (ClockPublicSetupTapeLaw.standardLaws d)
          (ClockRetainedFinalSplice.code P hR hc hsmall
            ClockRetainedTapeTransport.anchorClock ell)))).map
        (fun a => (a.1,
          ClockJointClockExecutionKernel.output P hR hc hsmall ell G
            ((a.2.1,a.1),a.2.2))) := by
  let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
    tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)
  have hprob : IsProbabilityMeasure (drawLaw P hR hc hsmall (d := d) ell) :=
    drawLaw_probability P hR hc hsmall (d := d) ell
  have hsfin : SFinite (drawLaw P hR hc hsmall (d := d) ell) := by
    have := hprob
    infer_instance
  have hdraw : Measurable (fun a : (Point d × Point d) ×
      (UniformValue × Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell)) =>
      (a.1,(clockOfUniform a.2.1,a.2.2))) :=
    measurable_fst.prodMk
      ((measurable_clockOfUniform.comp measurable_snd.fst).prodMk measurable_snd.snd)
  have hout : Measurable (fun a : (Point d × Point d) ×
      (ClockLaw.Clock × Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell)) =>
      (a.1, ClockJointClockExecutionKernel.output P hR hc hsmall ell G
        ((a.2.1,a.1),a.2.2))) :=
    measurable_fst.prodMk
      ((ClockJointClockExecutionKernel.output_measurable P hR hc hsmall ell G hG).comp
        (((measurable_snd.fst).prodMk measurable_fst).prodMk measurable_snd.snd))
  have hprod : (ν.prod (drawLaw P hR hc hsmall ell)).map
      (fun a => (a.1,(clockOfUniform a.2.1,a.2.2))) =
      ν.prod (Kinetic.sourceClockLaw.prod
        (tapeLaw (ClockPublicSetupTapeLaw.standardLaws d)
          (ClockRetainedFinalSplice.code P hR hc hsmall
            ClockRetainedTapeTransport.anchorClock ell))) := by
    rw [← drawLaw_map P hR hc hsmall (d := d) ell]
    convert (Measure.map_prod_map ν (drawLaw P hR hc hsmall ell)
      measurable_id ((measurable_clockOfUniform.comp measurable_fst).prodMk
        measurable_snd)).symm using 1
    · congr 1
    · simp
    · exact hsfin
  calc
    ν ⊗ₘ kernel P hR hc hsmall ell G hG =
      (ν.prod (drawLaw P hR hc hsmall ell)).map
        (fun a => (a.1, output P hR hc hsmall ell G a)) := by
          unfold kernel
          exact Channels.compProd_freshKernel ν _ _
            (output_measurable P hR hc hsmall ell G hG)
    _ = ((ν.prod (drawLaw P hR hc hsmall ell)).map
      (fun a => (a.1,(clockOfUniform a.2.1,a.2.2)))).map
        (fun a => (a.1,
          ClockJointClockExecutionKernel.output P hR hc hsmall ell G
            ((a.2.1,a.1),a.2.2))) := by
              rw [Measure.map_map hout hdraw]
              rfl
    _ = _ := by rw [hprod]


/-- The original joint input's output marginal under the literal primitive
draw and complete retained tape. -/
theorem outputLaw_composition (G : Point d → Point d) (hG : Measurable G)
    (ν : Measure (Point d × Point d)) [SFinite ν] :
    let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
      tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell)
    kernel P hR hc hsmall ell G hG ∘ₘ ν =
      ((ν.prod (Kinetic.sourceClockLaw.prod
        (tapeLaw (ClockPublicSetupTapeLaw.standardLaws d)
          (ClockRetainedFinalSplice.code P hR hc hsmall
            ClockRetainedTapeTransport.anchorClock ell)))).map
        (fun a => (a.1,
          ClockJointClockExecutionKernel.output P hR hc hsmall ell G
            ((a.2.1,a.1),a.2.2)))).map Prod.snd := by
  rw [← Measure.snd_compProd ν (kernel P hR hc hsmall ell G hG),
    compProd_kernel P hR hc hsmall ell G hG ν]
  rfl

/-- The same literal primitive construction for the original C² potential. -/
def originalGradientKernel (V : Point d → ℝ) (hV : ContDiff ℝ 2 V) :
    Kernel (Point d × Point d) (Point d) :=
  kernel P hR hc hsmall ell (gradient V)
    (ClockOriginalGradientKernel.originalGradient_measurable hV)

instance originalGradientKernel_markov (V : Point d → ℝ) (hV : ContDiff ℝ 2 V) :
    IsMarkovKernel (originalGradientKernel P hR hc hsmall ell V hV) := by
  unfold originalGradientKernel
  infer_instance


/-- The arbitrary warm joint input law with the actual original gradient is the
independent source-clock/full-tape pushforward through the literal root. -/
theorem originalGradient_compProd (V : Point d → ℝ) (hV : ContDiff ℝ 2 V)
    (ν : Measure (Point d × Point d)) [SFinite ν] :
    let : MeasurableSpace (Tape d (ClockRetainedFinalSplice.code P hR hc hsmall
      ClockRetainedTapeTransport.anchorClock ell)) :=
      tapeSpace d (ClockRetainedFinalSplice.code P hR hc hsmall
        ClockRetainedTapeTransport.anchorClock ell)
    ν ⊗ₘ originalGradientKernel P hR hc hsmall ell V hV =
      (ν.prod (Kinetic.sourceClockLaw.prod
        (tapeLaw (ClockPublicSetupTapeLaw.standardLaws d)
          (ClockRetainedFinalSplice.code P hR hc hsmall
            ClockRetainedTapeTransport.anchorClock ell)))).map
        (fun a => (a.1,
          ClockJointClockExecutionKernel.output P hR hc hsmall ell (gradient V)
            ((a.2.1,a.1),a.2.2))) :=
  compProd_kernel P hR hc hsmall ell (gradient V)
    (ClockOriginalGradientKernel.originalGradient_measurable hV) ν

end AcceleratedLogConcave.Root.ClockUniformExecutionKernel
