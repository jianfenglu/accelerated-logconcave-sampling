import Mathlib.Analysis.InnerProductSpace.Projection.Basic

/-!
# Abstract gradient projection

The supplied closed subspace and weak equation are explicit hypotheses.
Constructing the weighted gradient operator, its domain and closure, and a
Poisson inverse satisfying the weak equation is downstream analytic work.
No such realization or inverse is postulated here.
-/

noncomputable section

namespace AcceleratedLogConcave.Analysis.Poisson

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [CompleteSpace E]

/-- Orthogonal projection onto a supplied closed space of gradient fields. -/
def gradientProjection (G : ClosedSubmodule ℝ E) : E →L[ℝ] E :=
  G.toSubmodule.starProjection

@[simp]
theorem gradientProjection_mem (G : ClosedSubmodule ℝ E) (v : E) :
    gradientProjection G v ∈ G :=
  G.toSubmodule.starProjection_apply_mem v

/-- The contraction bound needs no spectral-gap constant. -/
theorem gradientProjection_norm_le (G : ClosedSubmodule ℝ E) :
    ‖gradientProjection G‖ ≤ 1 :=
  G.toSubmodule.starProjection_norm_le

theorem norm_gradientProjection_apply_le (G : ClosedSubmodule ℝ E) (v : E) :
    ‖gradientProjection G v‖ ≤ ‖v‖ :=
  G.toSubmodule.norm_starProjection_apply_le v

@[simp]
theorem gradientProjection_apply_of_mem (G : ClosedSubmodule ℝ E)
    {v : E} (hv : v ∈ G) : gradientProjection G v = v :=
  G.toSubmodule.starProjection_eq_self_iff.mpr hv

@[simp]
theorem gradientProjection_idempotent (G : ClosedSubmodule ℝ E) (v : E) :
    gradientProjection G (gradientProjection G v) = gradientProjection G v :=
  gradientProjection_apply_of_mem G (gradientProjection_mem G v)

/-- The defining weak orthogonality relation of the projection. -/
theorem gradientProjection_weak (G : ClosedSubmodule ℝ E) (v : E)
    {w : E} (hw : w ∈ G) :
    inner ℝ (v - gradientProjection G v) w = 0 :=
  Submodule.starProjection_inner_eq_zero v w hw

/-- A vector in the specified closed space satisfying its weak equation is
exactly the orthogonal projection. This proves uniqueness, not existence of a
Poisson solution. -/
theorem eq_gradientProjection_of_weak (G : ClosedSubmodule ℝ E) {v u : E}
    (hu : u ∈ G)
    (hweak : ∀ w ∈ G, inner ℝ (v - u) w = 0) :
    u = gradientProjection G v :=
  (Submodule.eq_starProjection_of_mem_of_inner_eq_zero hu hweak).symm

section GradientRange

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- The closed range generated by a specified linear gradient map.
The domain type `V` may be the domain of an unbounded gradient; continuity of
`D` is deliberately not assumed. -/
def closedGradientRange (D : V →ₗ[ℝ] E) : ClosedSubmodule ℝ E :=
  D.range.closure

omit [CompleteSpace E] in
theorem gradient_mem_closedGradientRange (D : V →ₗ[ℝ] E) (φ : V) :
    D φ ∈ closedGradientRange D :=
  D.range.le_topologicalClosure ⟨φ, rfl⟩

/-- Testing against actual gradients suffices: their orthogonal complement
agrees with that of their closure. -/
theorem eq_gradientProjection_of_gradient_tests (D : V →ₗ[ℝ] E)
    {v u : E} (hu : u ∈ closedGradientRange D)
    (hweak : ∀ φ : V, inner ℝ (v - u) (D φ) = 0) :
    u = gradientProjection (closedGradientRange D) v := by
  apply (Submodule.eq_starProjection_of_mem_orthogonal hu ?_).symm
  change v - u ∈ (D.range.closure : Submodule ℝ E)ᗮ
  rw [ClosedSubmodule.orthogonal_closure]
  apply (Submodule.mem_orthogonal' _ _).2
  rintro w ⟨φ, rfl⟩
  exact hweak φ

/-- Abstract identification of `D u`, for any supplied weak Poisson solution
`u`. The theorem does not construct `L⁻¹ D*`. -/
theorem poissonGradient_eq_projection (D : V →ₗ[ℝ] E) (v : E) (u : V)
    (hweak : ∀ φ : V, inner ℝ (D u) (D φ) = inner ℝ v (D φ)) :
    D u = gradientProjection (closedGradientRange D) v := by
  apply eq_gradientProjection_of_gradient_tests D
    (gradient_mem_closedGradientRange D u)
  intro φ
  rw [inner_sub_left, ← hweak φ, sub_self]

/-- A supplied continuous operator with the correct range and weak equation
is the projection; no inverse or PDE axiom is added. -/
theorem operator_eq_gradientProjection (D : V →ₗ[ℝ] E) (C : E →L[ℝ] E)
    (hmem : ∀ v, C v ∈ closedGradientRange D)
    (hweak : ∀ v φ, inner ℝ (v - C v) (D φ) = 0) :
    C = gradientProjection (closedGradientRange D) := by
  ext v
  exact eq_gradientProjection_of_gradient_tests D (hmem v) (hweak v)

/-- The manuscript's projection norm bound for any supplied operator identified
by the gradient weak equation. -/
theorem operator_norm_le_of_weak (D : V →ₗ[ℝ] E) (C : E →L[ℝ] E)
    (hmem : ∀ v, C v ∈ closedGradientRange D)
    (hweak : ∀ v φ, inner ℝ (v - C v) (D φ) = 0) :
    ‖C‖ ≤ 1 := by
  rw [operator_eq_gradientProjection D C hmem hweak]
  exact gradientProjection_norm_le _

end GradientRange

end AcceleratedLogConcave.Analysis.Poisson
